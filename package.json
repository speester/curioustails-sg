{
  "name": "curious-tails",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astro": "astro",
    "audit": "node scripts/seo-audit.mjs",
    "blog:create": "node scripts/blog_creator_daily.mjs",
    "build": "astro build",
    "build:deploy": "npm run sync:puppies && npm run feed:check && npm run build",
    "check:anchors": "node scripts/anchor-registry.mjs --report",
    "check:blog": "node --experimental-strip-types scripts/gen-blog-pages.mjs --check",
    "check:blueprint": "node scripts/validate-blueprint.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:contrast": "node scripts/contrast-check.mjs --tokens && node scripts/contrast-check.mjs --pages --all",
    "check:design": "node scripts/design-audit.mjs --all",
    "check:dims": "node scripts/gen-image-dims.mjs",
    "check:eeat": "node scripts/gen-eeat.mjs --check",
    "check:fonts": "node scripts/check-fonts.mjs --all",
    "check:form": "node scripts/check-form-sync.mjs",
    "check:formaloo-map": "node scripts/gen-formaloo-map.mjs",
    "check:formstates": "node scripts/check-form-states.mjs",
    "check:ga4": "node scripts/ga4-events.mjs",
    "check:health": "node scripts/page-health.mjs --all",
    "check:hgates": "node scripts/h-gates.mjs --all",
    "check:imagesrc": "node scripts/check-image-source.mjs",
    "check:index": "node scripts/gen-posts.mjs --check",
    "check:keyboard": "node scripts/page-health.mjs --keyboard --all",
    "check:kit": "node scripts/check-kit.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:page": "node scripts/page-check.mjs --all",
    "check:posts": "node scripts/gen-posts.mjs",
    "check:quotes": "node scripts/check-quotes.mjs",
    "check:redirects": "node scripts/gen-redirects.mjs",
    "check:refs:stale": "node scripts/check-references.mjs --stale 90",
    "check:registry": "node scripts/gen-registry.mjs --check",
    "check:related": "node scripts/check-related.mjs",
    "check:schema": "node scripts/check-schema-rich.mjs --all",
    "check:schema:req": "node scripts/check-schema-required.mjs --all",
    "check:sources": "node scripts/check-references.mjs && node scripts/check-references.mjs --blocks",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:variants": "node scripts/gen-image-variants.mjs --check",
    "deploy": "bash scripts/deploy-pages.sh",
    "deploy:preview": "bash scripts/deploy-pages.sh --preview",
    "dev": "astro dev",
    "feed:check": "node scripts/check-feed-freshness.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "gbp:daily": "node scripts/scheduler.mjs",
    "gbp:post": "node scripts/publish-daily-post.mjs",
    "gbp:reviews": "node scripts/reply-to-reviews.mjs",
    "gen:anchors": "node scripts/anchor-registry.mjs --regenerate",
    "gen:blog": "node --experimental-strip-types scripts/gen-blog-pages.mjs --write",
    "gen:buildid": "node scripts/gen-build-id.mjs",
    "gen:dims": "node scripts/gen-image-dims.mjs --write",
    "gen:eeat": "node scripts/gen-eeat.mjs",
    "gen:formaloo-map": "node scripts/gen-formaloo-map.mjs --write",
    "gen:posts": "node scripts/gen-posts.mjs --write",
    "gen:redirects": "node scripts/gen-redirects.mjs --write",
    "gen:registry": "node scripts/gen-registry.mjs",
    "gen:variants": "node scripts/gen-image-variants.mjs --write",
    "indexnow": "python \"%USERPROFILE%/.claude/scripts/indexnow_submit.py\" --domain curioustails.sg --key-file config/indexnow-key.txt --verify-key --sitemap https://curioustails.sg/sitemap-index.xml",
    "prebuild": "node scripts/gen-build-id.mjs",
    "preview": "astro preview",
    "qc": "python scripts/verify_page.py --all",
    "qc:all": "python scripts/verify_page.py --all",
    "sync:puppies": "node scripts/sync-puppies.mjs",
    "verify": "npm run build && npm run check:tokens && npm run check:kit && npm run check:anchors && npm run check:blog && npm run check:blueprint && npm run check:content && npm run check:contrast && npm run check:design && npm run check:fonts && npm run check:form && npm run check:formstates && npm run check:health && npm run check:hgates && npm run check:imagesrc && npm run check:index && npm run check:links && npm run check:page && npm run check:quotes && npm run check:refs:stale && npm run check:registry && npm run check:schema && npm run check:schema:req && npm run check:sources && npm run check:related && npm run check:keyboard && npm run check:variants && npm run check:dims && npm run check:formaloo-map && npm run check:posts && npm run check:redirects && npm run qc && npm run audit && python scripts/ledger.py check",
    "verify:scaffold": "npm run build && npm run check:kit && npm run check:tokens && npm run check:blueprint && npm run check:content && npm run check:design && npm run check:contrast && npm run check:fonts && npm run check:formstates && npm run check:health && npm run check:schema",
    "wordcount": "node scripts/wordcount.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "dotenv": "^16.4.5",
    "gsap": "^3.15.0",
    "node-cron": "^3.0.3",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.3"
  }
}
