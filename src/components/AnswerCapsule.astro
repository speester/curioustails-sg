---
// kit:AnswerCapsule@1.0.0 - the front-loaded 40-60 word answer.
interface Props { label?: 'The short answer' | 'The verdict'; }
const { label = 'The short answer' } = Astro.props as Props;

// The capsule is painted OUTSIDE the section rhythm but sits in the page flow, usually between
// the hero and the first section. The seam after it is computed against whatever tone the
// rhythm last recorded, so without this it is painted against the hero it no longer touches
// and renders as a band of the wrong colour. markTone exists for exactly this case.
import { markTone } from '../lib/section-rhythm';
if (Astro.locals?.rhythm) markTone(Astro.locals.rhythm, 'tint');
---
{/* A plain <div>. <figure> was tried to make the capsule count as a structural break, but a
    figure holding prose paragraphs is a misuse of the element and the landmark check is right
    to object. The capsule is one tight paragraph instead, which is what a front-loaded answer
    should be anyway, so it never forms a run with the dek above it. */}
<div class="answer-capsule" data-answer-capsule data-treatment="callout" role="note" aria-label={label}>
  <div class="answer-capsule__label">{label}</div>
  <div class="answer-capsule__body"><slot /></div>
</div>
<style>
  /* The capsule sits directly above a seam divider when it is hoisted to the top of a page.
     Its own bottom margin then shows as a hairline gap between the divider and the band above
     it, which is the thing the seam is meant to hide. */
  .answer-capsule:has(+ .section-divider) { margin-block-end: 0; }
  .answer-capsule { border: 1px solid var(--border-soft); border-left: 4px solid var(--color-accent); background: var(--surface-tint); border-radius: var(--radius-md); padding: 1rem 1.25rem; margin-block: 1.5rem; }
  .answer-capsule__label { margin: 0 0 .35rem; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-kicker); }
  .answer-capsule__body > :last-child { margin-bottom: 0; }
</style>
