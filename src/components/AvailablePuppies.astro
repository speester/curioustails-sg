---
// Real inventory section for breed pages, driven by src/data/available-puppies.json
// (written by `npm run sync:puppies` from the owner's SpreadSimple sheet).
// Every breed page renders BOTH sections when it has the data:
//  - Available <breed> Puppies:        real pups in stock right now
//  - Recently Placed <breed> Puppies:  the breed's latest real placed pups
// With no stock, an "contact us for latest availability" CTA sits directly
// under the recently-placed grid (or stands alone when there are no cards).
import ListingGrid from './ListingGrid.astro';
import AvailabilityCta from './AvailabilityCta.astro';
import data from '../data/available-puppies.json';
import { pupCard, livePupCards, stockedBreeds, type BreedBucket } from '../lib/puppy-cards';
import { nearestBreeds } from '../data/breed-neighbours';
import { breedName as displayBreedName } from '../data/breed-names';

// "Maltipoo, Cockapoo and Cavapoo" — an Oxford-comma-free English list.
const listNames = (names: string[]) =>
  names.length <= 1 ? (names[0] ?? '') : `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;

interface Props {
  breed: string; // page slug, e.g. "mini-dachshund"
  breedName: string; // display name, e.g. "Mini Dachshund"
}
const { breed, breedName } = Astro.props;

const entry = (data.breeds as Record<string, BreedBucket>)[breed];
const available = entry?.available ?? [];
const placed = entry?.recentlyPlaced ?? [];
const hasStock = available.length > 0;

const availableItems = available.map((p) => pupCard(p, breedName, 'available'));
const placedItems = placed.map((p) => pupCard(p, breedName, 'placed'));

// Workstream A2.4: with no stock, this page used to end in an availability CTA
// that converted 0%. Show real puppies of the nearest breeds instead — someone
// who came for a Toy Poodle will look at a Maltipoo, but only if they can see
// one. The waitlist ask (AvailabilityCta) still follows; a dead end does not
// convert, a waitlist does.
const nearest = hasStock ? [] : nearestBreeds(breed, stockedBreeds().map(([slug]) => slug));
const nearestItems = nearest.length > 0 ? livePupCards(3, nearest) : [];
const nearestNames = nearest.map((slug) => displayBreedName(slug));
---

{
  hasStock && (
    <ListingGrid
      heading={`Available ${breedName} Puppies`}
      headingAccent="Available"
      subhead={`Real ${breedName} puppies in stock right now, updated from our live list. Litters move fast, so tap any pup to WhatsApp us for its latest photos, video and health records, or to arrange a viewing at our Balestier shop.`}
      items={availableItems}
    />
  )
}

{
  placedItems.length > 0 && (
    <ListingGrid
      heading={`Recently Placed ${breedName} Puppies`}
      headingAccent="Recently Placed"
      subhead={
        hasStock
          ? `Recent ${breedName} puppies for sale in Singapore that have already found their families. Here is a sense of the colours, sizes and prices that come through our Balestier shop.`
          : `These ${breedName} puppies for sale in Singapore found their families fast, and most litters are reserved within days. Ask about a similar puppy and we'll WhatsApp you photos, prices and timing for the next ${breedName} litter.`
      }
      items={placedItems}
    />
  )
}

{
  nearestItems.length > 0 && (
    <ListingGrid
      heading={`No ${breedName}s In Today. These Are The Closest`}
      headingAccent="The Closest"
      subhead={`Real puppies in our care right now from the breeds that sit closest to the ${breedName} on size, coat and temperament: ${listNames(nearestNames)}. Every price is the all-in price. If it has to be a ${breedName}, ask us below and we will message you the moment one arrives.`}
      items={nearestItems}
      footerCtaLabel="See every puppy available now"
      footerCtaHref="/available-puppies/"
    />
  )
}

{!hasStock && <AvailabilityCta breedName={breedName} standalone={placedItems.length === 0 && nearestItems.length === 0} />}
