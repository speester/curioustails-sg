---
// kit:EeatFinding@1.0.0 - the Stage 0.6 evidence bank, rendered so the wrong output is
// impossible rather than merely forbidden (contracts.md §23, Stage 3 exit-gate letter (q)).
//
// WHY A COMPONENT AND NOT A RULE. Letter (q) measures `data-eeat`, a hedge attribute that
// must agree with the finding's confidence, a limitation that must sit beside the claim, and
// a source cited on the same page. Every one of those was, for one day, a sentence in
// content-writer's skill that a writer had to remember. The pipeline's own first rule says a
// rule that lives only in prose gets skipped, so this component derives all four from the
// research file and throws at build when they cannot be derived.
//
// Reads the ONE registry: research/eeat-findings.json, imported through src/data/eeat.ts.
import { EEAT_FINDINGS } from '../data/eeat';

interface Props {
  /** The finding id, e.g. "E17". The ONLY required prop: everything else is derived. */
  id: string;
  /** Optional heading override. Defaults to the brief's outline heading for this finding. */
  heading?: string;
  treatment?: 'panel' | 'rail' | 'plain';
}

const p = Astro.props as Props;
const f = EEAT_FINDINGS.find((x) => x.id === p.id) ?? null;

if (!f) {
  throw new Error(
    `[EeatFinding] unknown finding id "${p.id}". The id must exist in research/eeat-findings.json ` +
    `- run \`python scripts/gen-eeat.mjs\` (or npm run gen:eeat) to regenerate src/data/eeat.ts. ` +
    `Inventing a finding id is a contracts §23 fabrication, not a typo.`
  );
}

// The three fields a finding cannot ship without. They are separate errors on purpose: a
// missing limitation is how a sourced fact quietly becomes a misleading one.
if (!f.limitation) {
  throw new Error(`[EeatFinding] finding ${f.id} has no limitation. A claim without its qualification is a misleading claim.`);
}
if (!['High', 'Medium', 'Low'].includes(f.confidence)) {
  throw new Error(`[EeatFinding] finding ${f.id} has confidence "${f.confidence}"; contracts §23 allows High, Medium or Low.`);
}
if (!f.sources?.length || !f.sources[0]?.url) {
  throw new Error(`[EeatFinding] finding ${f.id} carries no source URL. A source with no URL is not a source.`);
}

// DERIVED, NEVER HAND-SET. The hedge marker is a function of the confidence level, so a
// writer cannot state a Low-confidence anecdote plainly by forgetting an attribute, and
// cannot bury a High-confidence fact in hedging by adding one.
const hedged = f.confidence === 'Medium' || f.confidence === 'Low';
const firstHand = f.type?.startsWith('First-hand') ?? false;
const heading = p.heading ?? f.heading ?? null;
if (!heading) {
  throw new Error(`[EeatFinding] finding ${f.id} has no heading. Pass one, or put it in the brief's outline - letter (q) requires a heading inside the section.`);
}

// The body is the WRITER'S prose, passed as the default slot. The component deliberately
// does NOT render f.claim: pasting the research verbatim is the failure mode letter (q)
// checks for (`finding_pasted_verbatim`), so the claim text is not even available to paste.
const treatment = p.treatment ?? 'panel';
---
<section
  class={`eeat eeat--${treatment}`}
  data-eeat={f.id}
  data-eeat-hedged={hedged ? '' : undefined}
  data-treatment="evidence"
  data-tone={firstHand ? 'account' : 'authority'}
>
  <h2 class="eeat__heading">{heading}</h2>

  {firstHand && (
    <p class="eeat__kicker">
      A documented first-hand account, not a market pattern.
      {f.observation_context && <> {f.observation_context}</>}
    </p>
  )}

  <div class="eeat__body">
    <slot />
  </div>

  <p class="eeat__limitation">
    <strong>What this does not say:</strong> {f.limitation}
  </p>

  <p class="eeat__sources">
    {f.sources.map((s, i) => (
      <>
        {i > 0 && <> · </>}
        <a href={s.url} rel="noopener nofollow" target="_blank" data-eeat-source={f.id}>{s.name}</a>
        {s.date && <> ({s.date})</>}
      </>
    ))}
  </p>
</section>

<style>
  .eeat { display: grid; gap: .6rem; margin-block: clamp(1.75rem, 4.5vw, 2.75rem); }
  .eeat--panel { padding: 1.25rem 1.5rem; border-radius: var(--radius-md); background: var(--surface-tint); }
  .eeat--rail { border-left: 4px solid var(--color-accent); padding-left: 1rem; }
  .eeat__heading { margin: 0; }
  .eeat__kicker { margin: 0; font-size: var(--text-sm); color: var(--ink-kicker); }
  .eeat__body > :first-child { margin-top: 0; }
  .eeat__body > :last-child { margin-bottom: 0; }
  .eeat__limitation { margin: 0; font-size: var(--text-sm); color: var(--ink-soft); }
  .eeat__sources { margin: 0; font-size: var(--text-xs); color: var(--ink-soft); }
  /* A hedged finding is visually quieter than a verified one: the page should not present
     one documented account with the same weight as a statutory requirement. */
  .eeat[data-eeat-hedged] { background: transparent; border: 1px dashed var(--border-soft); }
</style>
