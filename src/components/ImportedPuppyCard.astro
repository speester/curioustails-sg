---
// One imported-puppy reservation card. Shared by the breed-page section and the
// site-wide /available-puppies/ section so the two surfaces can never drift.
// Every word is copy deck §1 (reports/imported-puppy-copy-deck-2026-11-08.md);
// every number comes from src/data/imported-puppies.json.
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';
import PawPrint from './decor/PawPrint.astro';
import { whatsappLink } from '../data/site';
import { RESERVATION_TERMS_LABEL, RESERVATION_TERMS_PATH } from '../data/buying-terms';
import {
  altFor,
  arrivalLine,
  cardTitle,
  depositText,
  detailPath,
  hdbLine,
  importedPhotoFor,
  oldEnoughToFly,
  PERKS_LINE,
  priceText,
  reservedMessage,
  reserveMessage,
  SAMPLE_LABEL,
  type ImportedPup,
} from '../lib/imported-puppies';

interface Props {
  pup: ImportedPup;
  breedName?: string;
}
const { pup } = Astro.props;
const reserved = pup.status === 'reserved';
const photo = importedPhotoFor(pup.photos?.[0]);
const hdb = hdbLine(pup);
const href = detailPath(pup);
const waHref = whatsappLink(reserved ? reservedMessage(pup) : reserveMessage(pup));
const cta = reserved ? 'Ask about the next one' : 'Reserve on WhatsApp';
const title = cardTitle(pup);
const alt = altFor(pup, 0);
---

<div class="clay flex h-full flex-col overflow-hidden bg-[var(--color-surface-card)]" data-sample={pup.sample ? 'true' : undefined}>
  {pup.sample && (
    <p
      data-sample-label
      role="note"
      class="m-3 mb-0 rounded-[0.9rem] border-2 border-dashed border-[var(--color-coral-600)] bg-[var(--color-peach-100)] px-3 py-2 text-center text-sm font-bold leading-snug text-[var(--color-cream-900)]"
    >
      {SAMPLE_LABEL}
    </p>
  )}
  <div class="relative p-3 pb-0">
    <div class="overflow-hidden rounded-[1.1rem]">
      <div class="aspect-[4/3] w-full overflow-hidden">
        {photo ? (
          <Image
            src={photo}
            alt={alt}
            width={640}
            height={480}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 ease-out hover:scale-[1.04]"
          />
        ) : (
          <PlaceholderImage alt={alt} ratio="aspect-[4/3]" />
        )}
      </div>
    </div>
    <span
      class:list={[
        'absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-bold text-white shadow-[0_3px_0_0_rgba(0,0,0,0.18)]',
        reserved ? 'bg-[var(--color-cream-600)]' : 'bg-[var(--color-lilac-900)]',
      ]}
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
      {reserved ? 'Reserved' : pup.origin === 'IE' ? 'In Ireland · Reserve' : pup.origin === 'AU' ? 'In Australia · Reserve' : 'Available for reservation · Imported'}
    </span>
    {!reserved && oldEnoughToFly(pup) && (
      <span class="absolute right-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-mint-100)] px-2.5 py-1 text-xs font-bold text-[var(--color-lilac-700)] shadow-[0_3px_0_0_rgba(0,0,0,0.12)]">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
        Old enough to fly
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-[family-name:var(--font-heading)] font-semibold text-[var(--color-cream-900)]">
      {title}
    </h3>
    <p class="mt-1 text-xl font-bold text-[var(--color-coral-600)]">
      {priceText(pup)}<span class="ml-1 text-xs font-semibold text-[var(--color-cream-600)]">all-in to your door</span>
    </p>

    <ul class="mt-3.5 mb-4 space-y-2 border-t-2 border-dashed border-[var(--color-cream-200)] pt-3.5 text-sm text-[var(--color-cream-700)]">
      <li class="flex items-start gap-2.5">
        <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
        <span>50% deposit to reserve: <span class="font-semibold">{depositText(pup)}</span></span>
      </li>
      <li class="flex items-start gap-2.5">
        <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
        <span>Balance due before your puppy flies</span>
      </li>
      <li class="flex items-start gap-2.5">
        <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
        <span>{arrivalLine(pup)}</span>
      </li>
      {pup.age && (
        <li class="flex items-start gap-2.5">
          <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
          <span>{pup.age} old</span>
        </li>
      )}
      {hdb && (
        <li class="flex items-start gap-2.5">
          <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
          <span>{hdb}</span>
        </li>
      )}
      <li class="flex items-start gap-2.5">
        <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
        <span>{PERKS_LINE}</span>
      </li>
      <li class="flex items-start gap-2.5">
        <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
        <span>Ref <span class="font-semibold">{pup.ref}</span></span>
      </li>
      <li class="flex items-start gap-2.5">
        <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
        <a href={RESERVATION_TERMS_PATH} data-terms-link class="font-semibold text-[var(--color-coral-600)] underline underline-offset-2">{RESERVATION_TERMS_LABEL}</a>
      </li>
    </ul>

    <a
      href={waHref}
      data-wa-source={`import:${pup.id}`}
      class="clay-btn clay-press mt-auto inline-flex w-full items-center justify-center gap-2 whitespace-nowrap bg-[#25D366] px-5 py-3 text-sm font-bold text-white transition-transform hover:bg-[#1ebe57]"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
      {cta}
    </a>
    <a
      href={href}
      data-card-action="import_details"
      data-ga4-event="import_details_click"
      data-wa-source={`import:${pup.id}`}
      class="clay-btn-outline clay-press mt-2.5 inline-flex w-full items-center justify-center gap-2 bg-white px-5 py-2.5 text-sm font-bold text-[var(--color-coral-600)] transition-transform"
    >
      See photos &amp; details
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</div>
