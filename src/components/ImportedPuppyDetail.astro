---
// Imported reservation detail page (/puppies/<breed>/imp-<10 hex>/).
//
// Owner decision D11: noindex,follow and out of the sitemap. The page exists to
// take a reservation, not to rank; the breed page carries the SEO. It retires to
// a 301 on the breed page through src/data/imported-retired.json.
//
// Every claim, price and date below comes from src/data/imported-puppies.json or
// the approved copy deck (reports/imported-puppy-copy-deck-2026-11-08.md §3–4),
// with the payment wording settled in the legal redline (2026-11-13). No reviews,
// no UEN, no guarantee, no supplier, no county, no microchip, no original price.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import FAQ from '../components/FAQ.astro';
import FinalCta from '../components/FinalCta.astro';
import Schema from '../components/Schema.astro';
import PawPrint from '../components/decor/PawPrint.astro';
import { site, whatsappLink } from '../data/site';
import {
  altFor,
  arrivalLine,
  availabilityStarts,
  balanceText,
  depositText,
  displayName,
  importedPhotoFor,
  monthLabel,
  priceText,
  reservedMessage,
  reserveMessage,
  sexLine,
  type ImportedPup,
} from '../lib/imported-puppies';

interface Props {
  pup: ImportedPup;
}
const { pup } = Astro.props;

const reserved = pup.status === 'reserved';
const name = displayName(pup);
const month = monthLabel(pup.arrivalEstimate);
const canonicalPath = `/puppies/${pup.breed}/${pup.id}/`;
const waHref = whatsappLink(reserved ? reservedMessage(pup) : reserveMessage(pup));
const photos = (pup.photos ?? []).map((file, i) => ({ file, src: importedPhotoFor(file), alt: altFor(pup, i) })).filter((p) => p.src);
const hero = photos[0] ?? null;
const heroAbs = hero ? new URL(hero.src!.src, site.domain).toString() : undefined;

const pageTitle = `${pup.breedLabel} Puppy for Reservation · Arriving ${month} | Curious Tails`;
const description = `${name} puppy available for reservation, estimated arrival ${month} and subject to import approval. ${priceText(pup)} all-in, 50% deposit ${depositText(pup)}. Imported by Curious Tails, AVS licensed.`;

const hdbFaq =
  pup.hdbApproved === true
    ? "Yes. It's on HDB's approved breed list, one dog per flat."
    : pup.hdbApproved === false
      ? 'No. This breed is for condos and landed homes only.'
      : 'Ask us about HDB rules for this cross.';

const faqItems = [
  {
    question: 'Is this puppy in your shop?',
    answer:
      'No. This puppy is available for reservation and will be imported for you. When it arrives, it comes to your home with the same starter kit, setup and support as the puppies in our Balestier shop.',
  },
  {
    question: 'Is my deposit refundable?',
    answer:
      "Yes, in full, if the import can't go ahead for any reason that isn't your fault, or if arrival is more than 45 days late. If you change your mind before we've paid the breeder, we refund your deposit less a S$250 admin fee. After that, we refund what you've paid less the costs we can't recover, shown with receipts. Or, instead of cancelling, you can move everything you've paid to another puppy at no cost. Full terms come with your written reservation.",
  },
  {
    question: 'How soon will my puppy arrive?',
    answer:
      'Puppies fly at about 3 months old, so it depends on your puppy\'s age. Reserve at 8 weeks old and your puppy should arrive in about 4 weeks; at 6 weeks old, in about 6 weeks. Your written reservation gives an estimated date, worked out from your puppy\'s date of birth. If your puppy is already about 3 months old when you reserve, it flies once its paperwork and flight are ready, and your written reservation gives our estimate for that.',
  },
  {
    question: 'What if the arrival is late?',
    answer:
      'We give an estimated month, never a fixed date, and tell you within 2 business days if anything is likely to delay it. If arrival is more than 45 days past that month, you may cancel for a full refund of everything you\'ve paid.',
  },
  {
    question: 'Is there quarantine?',
    answer:
      'Our imports come from rabies-free countries, which have no quarantine when every AVS condition is met.',
  },
  { question: 'Is this breed allowed in an HDB flat?', answer: hdbFaq },
  {
    question: 'Can I see more photos or a video first?',
    answer:
      "Yes. Ask on WhatsApp and we'll request fresh photos or a video for you.",
  },
  {
    question: 'Is the price final?',
    answer:
      "Yes. The price shown is all-in, delivered to your door, and includes your puppy's first dog licence. No import, flight or clearance fees are added later.",
  },
];

const steps = [
  {
    title: 'Message us.',
    body: "Tell us which puppy and which boy or girl you'd like. We confirm availability, usually within 24 to 48 hours, before you pay anything.",
  },
  {
    title: 'Pay the 50% deposit.',
    body: "You get a written reservation with the breeder's name, the price, an estimated arrival date and the refund terms. We start the import: AVS import licence, vet health certificate and flight booking.",
  },
  {
    title: 'Pay the balance before the flight.',
    body: 'Once the flight and health certificate are confirmed, the remaining 50% is due.',
  },
  {
    title: 'Welcome home.',
    body: 'Your puppy lands, clears AVS checks at Changi, and we deliver to your door with the 30+ item starter kit and set everything up with you.',
  },
];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${name} puppy (imported, for reservation)`,
  ...(heroAbs ? { image: [heroAbs] } : {}),
  description,
  category: `${name} puppy`,
  brand: { '@type': 'Brand', name: 'Curious Tails' },
  offers: {
    '@type': 'Offer',
    price: pup.priceSGD,
    priceCurrency: 'SGD',
    availability: 'https://schema.org/PreOrder',
    ...(availabilityStarts(pup) ? { availabilityStarts: availabilityStarts(pup) } : {}),
    url: new URL(canonicalPath, site.domain).toString(),
    seller: { '@type': 'Organization', name: 'Curious Tails', url: site.domain },
  },
};

const includes = [
  'The import, flight and AVS clearance',
  'First dog licence',
  'Home delivery & setup',
  '30+ item starter kit ($500+ value)',
  'First training lesson with an AVS-certified trainer',
  'Ongoing WhatsApp support',
];

const profile = [
  { k: 'Breed', v: name },
  { k: 'Sex', v: sexLine(pup.sex) },
  ...(pup.colours.length ? [{ k: 'Colour', v: pup.colours.join(', ') }] : []),
  ...(pup.age ? [{ k: 'Age', v: `${pup.age} old` }] : []),
  { k: 'Estimated arrival', v: `${month} · subject to import approval` },
  { k: 'Reference', v: pup.ref },
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  noindex
  robots="noindex,follow"
  businessSchema={false}
  ogImage={heroAbs}
>
  <Schema schemas={[productLd]} />

  {/* HERO */}
  <section class="mx-auto max-w-[1400px] px-5 sm:px-8 pt-8 pb-14">
    <Breadcrumb
      items={[
        { label: 'Puppies', href: '/puppies/' },
        { label: pup.breedLabel, href: `/puppies/${pup.breed}/` },
        { label: `${pup.breedLabel} reservation`, href: canonicalPath },
      ]}
      bare
    />

    <div class="mt-6 grid items-start gap-8 lg:grid-cols-2">
      {/* GALLERY */}
      <div data-tilt>
        <div class="clay relative overflow-hidden bg-[var(--color-surface-card)] p-3">
          {hero?.src ? (
            <Image
              src={hero.src}
              alt={hero.alt}
              widths={[480, 768, 1000]}
              sizes="(max-width:1023px) 92vw, 640px"
              class="aspect-[4/3] w-full rounded-[1.1rem] object-cover"
            />
          ) : (
            <PlaceholderImage alt={altFor(pup, 0)} ratio="aspect-[4/3]" />
          )}
          <span
            class:list={[
              'absolute left-7 top-7 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-bold text-white shadow-[0_3px_0_0_rgba(0,0,0,0.18)]',
              reserved ? 'bg-[var(--color-cream-600)]' : 'bg-[var(--color-lilac-900)]',
            ]}
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
            {reserved ? 'Reserved' : 'Available for reservation · Imported'}
          </span>
        </div>
        {photos.length > 1 && (
          <ul class="mt-3 grid grid-cols-3 gap-3">
            {photos.slice(1, 4).map((photo) => (
              <li class="clay overflow-hidden bg-[var(--color-surface-card)] p-1.5">
                <Image src={photo.src!} alt={photo.alt} width={300} height={225} loading="lazy" class="aspect-[4/3] w-full rounded-[0.8rem] object-cover" />
              </li>
            ))}
          </ul>
        )}
      </div>

      {/* BUY BOX */}
      <div class="lg:py-2">
        <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-coral-600)]">{pup.breedLabel} · Imported</p>
        <h1 class="mt-2 font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.9rem, 4vw, 2.9rem);">
          {name} puppy, available for reservation
        </h1>
        <p class="mt-2 text-[var(--color-cream-600)]">
          {sexLine(pup.sex)}{pup.age ? ` · ${pup.age} old` : ''} · Estimated arrival {month}, subject to import approval
        </p>

        <div class="clay mt-5 bg-[var(--color-surface-card)] p-6">
          <p class="text-3xl font-bold text-[var(--color-coral-600)]">
            {priceText(pup)} <span class="text-base font-semibold text-[var(--color-cream-700)]">all-in</span>
          </p>
          <dl class="mt-4 divide-y divide-[var(--color-cream-200)] border-y-2 border-[var(--color-cream-200)]">
            <div class="flex items-center justify-between gap-4 py-3">
              <dt class="text-sm font-semibold text-[var(--color-cream-700)]">Reserve with 50%</dt>
              <dd class="font-bold text-[var(--color-cream-900)]" style="font-variant-numeric: tabular-nums;">{depositText(pup)}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 py-3">
              <dt class="text-sm font-semibold text-[var(--color-cream-700)]">Balance, due before your puppy flies</dt>
              <dd class="font-bold text-[var(--color-cream-900)]" style="font-variant-numeric: tabular-nums;">{balanceText(pup)}</dd>
            </div>
          </dl>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-cream-600)]">
            Includes the import, flight, AVS clearance, first dog licence, home delivery &amp; setup, starter kit and first training lesson.
          </p>
        </div>

        <div class="mt-5 flex flex-col gap-3">
          <a href={waHref} data-wa-source={`import:${pup.id}`} class="clay-btn clay-press inline-flex items-center justify-center gap-2 bg-[#25D366] px-6 py-4 text-base font-bold text-white transition-transform hover:bg-[#1ebe57]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
            {reserved ? 'Ask about the next one' : 'Reserve on WhatsApp'}
          </a>
          <a href="#how-reserving-works" class="clay-btn-outline clay-press inline-flex items-center justify-center gap-2 bg-white px-6 py-3.5 text-base font-bold text-[var(--color-coral-600)] transition-transform">
            How reserving works
          </a>
        </div>
        <p class="mt-4 text-sm text-[var(--color-cream-600)]">
          {reserved
            ? 'This puppy is reserved. Ask us on WhatsApp and we will tell you when the next one is available.'
            : 'We confirm this puppy is still available before you pay anything.'}
        </p>
      </div>
    </div>
  </section>

  {/* ABOUT + PROFILE */}
  <section class="bg-[var(--color-peach-100)] py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
      <div class="grid items-stretch gap-8 lg:grid-cols-[1.45fr_1fr]">
        <div class="clay flex flex-col bg-[var(--color-surface-card)] p-7 sm:p-9">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-coral-600)]">Reservation only</p>
          <h2 class="mt-2 font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">
            This puppy is not in our shop yet
          </h2>
          <div class="mt-5 space-y-4 text-[1.05rem] leading-relaxed text-[var(--color-cream-800)]">
            <p>
              {name} is available for reservation and will be imported for you. When {sexLine(pup.sex).includes('/') ? 'they arrive' : 'your puppy arrives'}, {sexLine(pup.sex).includes('/') ? 'they come' : 'it comes'} to your home with the same starter kit, setup and support as the puppies in our Balestier shop.
            </p>
            <p>
              {arrivalLine(pup)}. We confirm availability, usually within 24 to 48 hours, before you pay anything.
            </p>
          </div>

          <div class="mt-auto pt-8">
            <div class="rounded-[1.3rem] border-2 border-[var(--color-cream-200)] bg-[var(--color-peach-100)] p-6 sm:p-7">
              <h3 class="flex items-center gap-2.5 text-lg font-bold text-[var(--color-cream-900)]">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface-card)]">
                  <PawPrint class="h-5 w-5 text-[var(--color-coral-500)]" />
                </span>
                What's included
              </h3>
              <ul class="mt-4 grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
                {includes.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm font-semibold text-[var(--color-cream-800)]">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[var(--color-mint-100)] text-xs font-black text-[var(--color-lilac-700)]">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="clay flex flex-col bg-[var(--color-surface-card)] p-7">
          <h2 class="text-sm font-bold uppercase tracking-widest text-[var(--color-coral-600)]">This puppy's profile</h2>
          <dl class="mt-3 divide-y divide-[var(--color-cream-200)]">
            {profile.map((row) => (
              <div class="flex items-center justify-between gap-4 py-3.5">
                <dt class="text-xs font-bold uppercase tracking-wide text-[var(--color-cream-600)]">{row.k}</dt>
                <dd class="text-right font-semibold text-[var(--color-cream-900)]" style="font-variant-numeric: tabular-nums;">{row.v}</dd>
              </div>
            ))}
          </dl>
          <a href={waHref} data-wa-source={`import:${pup.id}`} class="clay-btn clay-press mt-auto inline-flex w-full items-center justify-center gap-2 bg-[#25D366] px-5 py-3.5 text-sm font-bold text-white transition-transform hover:bg-[#1ebe57]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
            {reserved ? 'Ask about the next one' : 'Ask about this puppy'}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* HOW RESERVING WORKS */}
  <section id="how-reserving-works" class="mx-auto max-w-[1400px] scroll-mt-28 px-5 sm:px-8 py-16">
    <div class="max-w-[70ch]">
      <h2 class="font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
        How reserving an <span class="text-[var(--color-coral-500)]">imported</span> puppy works
      </h2>
      <p class="mt-2 text-base text-[var(--color-cream-600)]">
        Four steps, no payment until we confirm this puppy is still available.
      </p>
    </div>
    <ol class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="clay flex h-full flex-col bg-[var(--color-surface-card)] p-6">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-coral-500)] text-base font-black text-white">{i + 1}</span>
          <h3 class="mt-4 text-lg font-bold text-[var(--color-cream-900)]">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-cream-700)]">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* PROMISES */}
  <section class="bg-[var(--color-lilac-100)] py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
      <div class="grid gap-7 lg:grid-cols-3">
        <div class="clay bg-[var(--color-surface-card)] p-7">
          <h2 class="text-xl font-bold text-[var(--color-cream-900)]">Our 5-day promise</h2>
          <p class="mt-3 text-[0.98rem] leading-relaxed text-[var(--color-cream-700)]">
            If your puppy falls sick within the first 5 days of arriving home in Singapore, bring them back and we'll nurse them ourselves and pay the vet fees at our appointed vet, Vets For Pets. The 5 days start on the day your puppy arrives home, not on the day you reserve.
          </p>
        </div>
        <div class="clay bg-[var(--color-surface-card)] p-7">
          <h2 class="text-xl font-bold text-[var(--color-cream-900)]">Boarding on arrival</h2>
          <p class="mt-3 text-[0.98rem] leading-relaxed text-[var(--color-cream-700)]">
            If you're not ready on arrival day, we board your puppy free, with lodging and food covered, for the first 14 days after arrival. After that, boarding costs S$30 a day.
          </p>
        </div>
        <div class="clay bg-[var(--color-surface-card)] p-7">
          <h2 class="text-xl font-bold text-[var(--color-cream-900)]">About the arrival estimate</h2>
          <p class="mt-3 text-[0.98rem] leading-relaxed text-[var(--color-cream-700)]">
            Puppies fly at about 3 months old, so we work out the arrival estimate from your puppy's date of birth. Reserve at 8 weeks old and your puppy should arrive in about 4 weeks; at 6 weeks old, in about 6 weeks. It's an estimate, not a fixed date: every import depends on AVS approval, the vet health certificate and an available flight. We'll keep you updated at every step on WhatsApp. If your puppy can't come, everything you've paid comes back to you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <FAQ heading={`${pup.breedLabel} reservation questions`} items={faqItems} />

  <FinalCta
    breed={name}
    heading={reserved ? 'Ask about the next one' : 'Reserve this puppy'}
    body="We confirm this puppy is still available before you pay anything. Message us and we will answer every question first."
    reserveMessage={reserved ? reservedMessage(pup) : reserveMessage(pup)}
    browseHref="/available-puppies/"
    browseLabel="See every puppy available now"
  />
</BaseLayout>
