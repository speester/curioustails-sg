---
// kit:JumpNav@1.0.0 — "On this page". Never a bare <p> of links.
interface Props { headings: { id: string; label: string }[]; label?: string; }
const { headings, label = 'On this page' } = Astro.props as Props;
if (!headings?.length) throw new Error('[JumpNav] `headings` is required - pass the brief\'s jump_links.');
---
<nav class="jumpnav" aria-label={label}>
  <p class="jumpnav__label">{label}</p>
  <ul class="jumpnav__list">
    {headings.map((h) => <li class="jumpnav__item"><a href={`#${h.id}`}>{h.label}</a></li>)}
  </ul>
</nav>
<style>
  .jumpnav__label { font-size: var(--text-sm); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-kicker); margin: 0 0 .5rem; }
  .jumpnav__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .jumpnav__item a { display: block; padding: .25rem .5rem; border-radius: var(--radius-sm); text-decoration: none; color: var(--ink); }
  .jumpnav__item a:hover, .jumpnav__item a:focus-visible { background: var(--surface-tint); }
</style>
