---
import PlaceholderImage from './PlaceholderImage.astro';
import PawPrint from './decor/PawPrint.astro';
import { fmtPrice } from '../data/pricing';

interface Item {
  title: string;
  href: string;
  imageAlt: string;
  imageSrc?: ImageMetadata;
  meta: string;
  price?: number; // all-in SGD price for this individual puppy
  points?: string[]; // quick point-form facts shown on the card
  ctaLabel?: string; // when set, renders a "View Breed"-style button instead of the WhatsApp one
  tag?: string;
  tagVariant?: 'muted'; // lilac tag (e.g. "Recently placed") instead of the coral default
  comingSoon?: boolean; // page not built yet: render a non-clickable "Coming soon" card (no link, no 404)
  gender?: 'Male' | 'Female';
  age?: string; // e.g. "2 months"
  location?: string; // e.g. "Balestier Area" or "Choa Chu Kang" - the pup's real location
  video?: string; // per-puppy clip URL; when set, a play badge + lightbox appear
  bookHref?: string; // cal.com booking link for this pup; renders a "Book Appointment" button
  waSource?: string; // GA4 wa_source tag (e.g. "pup:2630") for whatsapp_click attribution
  waVariant?: string; // GA4 wa_variant tag for the button-text A/B experiment
  pageHref?: string; // this puppy's own page (/puppies/<breed>/<id>/); renders a "Learn more" link
  isPup?: boolean; // real-inventory puppy card: new 2026-10 layout (breed ticket, chip row, icon actions)
  breed?: string; // display breed (or cross label) shown on the coloured ticket tag beside the price
  hdbApproved?: boolean | null; // true -> "HDB ✓" chip, false -> "HDB ✕" chip, null -> no claim
  videoHref?: string; // WhatsApp fallback used by the Video action when no clip is on file
}

// Per-breed ticket colour: a stable hash picks one of a small brand-safe palette
// so every breed keeps the same tag colour across the site, with legible white
// text on each. New breeds slot in automatically.
const TAG_PALETTE = ['#d64545', '#c9893b', '#8a5a3c', '#7a6cc4', '#2f8b74', '#c2567f', '#3f7cc0', '#b5671d'];
const breedTagColor = (breed: string) => {
  let h = 0;
  for (let i = 0; i < breed.length; i++) h = (h * 31 + breed.charCodeAt(i)) >>> 0;
  return TAG_PALETTE[h % TAG_PALETTE.length];
};
interface Props {
  heading: string;
  headingAccent?: string;
  subhead?: string;
  items: Item[];
  footerCtaLabel?: string;
  footerCtaHref?: string;
}
const { heading, headingAccent, subhead, items, footerCtaLabel, footerCtaHref } = Astro.props;
const headingParts = headingAccent ? heading.split(headingAccent) : [heading, ''];
const rotations = ['-rotate-2', 'rotate-2', '-rotate-1', 'rotate-1', '-rotate-2', 'rotate-1', '-rotate-1'];
---

<section class="mx-auto max-w-[1400px] px-5 sm:px-8 py-16">
  <div class="max-w-[65ch]">
    <h2 class="font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
      {headingParts[0]}{headingAccent && <span class="text-[var(--color-coral-500)]">{headingAccent}</span>}{headingParts[1]}
    </h2>
    {subhead && <p class="mt-2 text-base text-[var(--color-cream-600)]">{subhead}</p>}
  </div>

  {/* Always a 4-up track at desktop, so 1-3 cards keep the same card size as a full row. */}
  <ul class="mt-9 grid gap-7 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {items.map((item, i) => (
      <li data-reveal style={`--i:${i % 6}`}>
        <div
          data-tilt
          class={`group clay clay-hover flex h-full flex-col bg-[var(--color-surface-card)] overflow-hidden ${rotations[i % rotations.length]}`}
        >
          <div class="relative p-3 pb-0">
            <div class="overflow-hidden rounded-[1.1rem]">
              <div class="transition-transform duration-500 ease-out group-hover:scale-[1.08]">
                <PlaceholderImage alt={item.imageAlt} src={item.imageSrc} ratio="aspect-[4/3]" />
              </div>
            </div>
            {item.tag && (
              <span
                class:list={[
                  'absolute left-5 top-5 inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-bold text-white',
                  item.comingSoon || item.tagVariant === 'muted'
                    ? 'bg-[var(--color-lilac-900)] shadow-[0_3px_0_0_rgba(0,0,0,0.18)]'
                    : 'bg-[var(--color-coral-500)] shadow-[0_3px_0_0_var(--color-coral-700)]',
                ]}
              >
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-white"></span>
                {item.tag}
              </span>
            )}
          </div>
          <div class="flex flex-1 flex-col p-5">
            {!item.isPup && (
              <h3 class="text-lg font-[family-name:var(--font-heading)] font-semibold text-[var(--color-cream-900)]">
                {item.title}
              </h3>
            )}
            {item.isPup ? (
              <div class="flex items-end justify-between gap-2">
                {item.price ? (
                  <p class="text-xl font-bold text-[var(--color-coral-600)]">
                    ${fmtPrice(item.price)}
                    <span class="ml-1 text-xs font-semibold text-[var(--color-cream-600)]">all-in</span>
                  </p>
                ) : <span></span>}
                {item.breed && (
                  <span
                    class="relative inline-flex items-center gap-1.5 py-1.5 pl-4 pr-3 text-[13px] font-bold leading-none text-white"
                    style={`background:${breedTagColor(item.breed)};clip-path:polygon(10px 0,100% 0,100% 100%,10px 100%,0 50%)`}
                  >
                    <PawPrint class="h-3.5 w-3.5 text-white/90" />
                    {item.breed}
                  </span>
                )}
              </div>
            ) : item.price && (
              <p class="mt-1 text-xl font-bold text-[var(--color-coral-600)]">
                ${fmtPrice(item.price)}
                <span class="ml-1 text-xs font-semibold text-[var(--color-cream-600)]">all-in</span>
              </p>
            )}
            {(!item.points || item.points.length === 0) && item.ctaLabel && (
              <p class="mt-2 mb-4 text-sm leading-snug text-[var(--color-cream-700)]">{item.meta}</p>
            )}
            {item.points && item.points.length > 0 && (
              <ul class="mt-3.5 mb-5 space-y-2 border-t-2 border-dashed border-[var(--color-cream-200)] pt-3.5">
                {item.points.map((point) => (
                  <li class="flex items-start gap-2.5 text-sm leading-snug text-[var(--color-cream-700)]">
                    <PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />
                    {point}
                  </li>
                ))}
              </ul>
            )}
            {(item.gender || item.age || (item.isPup && item.hdbApproved != null)) && (
              <div class="mt-3 flex flex-nowrap items-center gap-1.5 overflow-hidden">
                {item.gender && (
                  <span
                    class:list={[
                      'inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-bold',
                      item.gender === 'Female'
                        ? 'bg-[var(--color-coral-100)] text-[var(--color-coral-700)]'
                        : 'bg-[var(--color-lilac-100)] text-[var(--color-lilac-700)]',
                    ]}
                  >
                    {item.gender === 'Female' ? (
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="9" r="5" /><path d="M12 14v7M9 18h6" stroke-linecap="round" /></svg>
                    ) : (
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="10" cy="14" r="5" /><path d="M15 9l5-5M15 4h5v5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    )}
                    {item.gender}
                  </span>
                )}
                {item.age && (
                  <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-[var(--color-mint-100)] px-2.5 py-1 text-xs font-bold text-[var(--color-lilac-700)]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    {item.age}
                  </span>
                )}
                {item.isPup && item.hdbApproved === true && (
                  <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-[var(--color-mint-100)] px-2.5 py-1 text-xs font-bold text-[var(--color-mint-800,#1f7a56)]">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.3 3.3a1 1 0 0 1 1.4 0l8 7.3a1 1 0 0 1-.7 1.7H19V20a1 1 0 0 1-1 1h-3v-5h-4v5H8a1 1 0 0 1-1-1v-7.7H4a1 1 0 0 1-.7-1.7Z" /></svg>
                    HDB ✓
                  </span>
                )}
                {item.isPup && item.hdbApproved === false && (
                  <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-[#fde6d6] px-2.5 py-1 text-xs font-bold text-[#b5651d]">
                    HDB ✕
                  </span>
                )}
              </div>
            )}
            {item.comingSoon ? (
              <span
                aria-label={`${item.title}, page coming soon`}
                class="mt-auto inline-flex w-full items-center justify-center gap-2 rounded-[var(--radius-btn,0.9rem)] border-2 border-dashed border-[var(--color-cream-300)] bg-[var(--color-cream-100)] px-5 py-3 text-sm font-bold text-[var(--color-cream-600)]"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
                Page coming soon
              </span>
            ) : item.ctaLabel ? (
              <a
                href={item.href}
                aria-label={`${item.ctaLabel}: ${item.title}, ${item.meta}`}
                class="clay-btn clay-press mt-auto inline-flex w-full items-center justify-center gap-2 text-center bg-[var(--color-accent)] px-5 py-3 text-sm font-bold text-white transition-transform hover:bg-[var(--color-accent-hover)]"
              >
                {item.ctaLabel}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            ) : item.isPup && (item.pageHref || item.videoHref || item.bookHref) ? (
            // New 2026-10 layout: one loud WhatsApp pill, then a row of three cute
            // icon actions (Book Appt / Video / Learn more). The Video action is
            // always present - with a clip it opens the lightbox, without one it
            // opens WhatsApp pre-asking for a video so it never dead-ends.
            <div class="mt-auto flex flex-col gap-3.5 pt-5">
              <a
                href={item.href}
                data-wa-source={item.waSource}
                data-wa-variant={item.waVariant}
                aria-label={item.price ? `${item.meta}: ${item.title}, $${fmtPrice(item.price)} all-in` : `${item.meta}: ${item.title}`}
                class="clay-btn clay-press inline-flex w-full min-w-0 items-center justify-center gap-2 whitespace-nowrap bg-[#25D366] px-4 py-3 text-sm font-bold text-white transition-transform hover:bg-[#1ebe57]"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.13c-.25.7-1.44 1.33-1.99 1.37-.53.05-.53.42-3.34-.7-2.81-1.12-4.55-3.98-4.69-4.16-.14-.19-1.12-1.49-1.12-2.84 0-1.35.71-2.01.96-2.29.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.85 2.06.92 2.21.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.14-.28.28-.12.56.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.16-.19.69-.81.88-1.09.19-.28.37-.23.62-.14.25.09 1.6.76 1.87.9.28.14.46.21.53.32.07.12.07.65-.18 1.35z" />
                </svg>
                <span class="min-w-0 truncate">{item.meta}</span>
              </a>
              <div class="grid grid-cols-3 gap-2">
                <a
                  href={item.bookHref ?? item.href}
                  {...item.bookHref ? { target: '_blank', rel: 'noopener' } : {}}
                  aria-label={`Book an appointment to visit ${item.title}`}
                  class="group/ic flex flex-col items-center gap-1.5 text-center"
                >
                  <span class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-[var(--color-cream-200)] bg-white text-[var(--color-coral-600)] transition group-hover/ic:-translate-y-0.5 group-hover/ic:border-transparent group-hover/ic:bg-[var(--color-coral-500)] group-hover/ic:text-white">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="17" rx="3" /><path d="M3 9h18M8 2.5v4M16 2.5v4" /></svg>
                  </span>
                  <span class="text-[11px] font-bold text-[var(--color-cream-700)]">Book Appt</span>
                </a>
                {item.video ? (
                  <button
                    type="button"
                    data-video={item.video}
                    data-video-title={item.title}
                    aria-label={`Watch a video of ${item.title}`}
                    class="js-video-open group/ic flex flex-col items-center gap-1.5 text-center"
                  >
                    <span class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-[var(--color-cream-200)] bg-white text-[var(--color-coral-600)] transition group-hover/ic:-translate-y-0.5 group-hover/ic:border-transparent group-hover/ic:bg-[var(--color-coral-500)] group-hover/ic:text-white">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="6" /><path d="M10 9l5 3-5 3z" fill="#fff" /></svg>
                    </span>
                    <span class="text-[11px] font-bold text-[var(--color-cream-700)]">Video</span>
                  </button>
                ) : (
                  <a
                    href={item.videoHref ?? item.href}
                    aria-label={`Ask on WhatsApp for a video of ${item.title}`}
                    class="group/ic flex flex-col items-center gap-1.5 text-center"
                  >
                    <span class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-[var(--color-cream-200)] bg-white text-[var(--color-coral-600)] transition group-hover/ic:-translate-y-0.5 group-hover/ic:border-transparent group-hover/ic:bg-[var(--color-coral-500)] group-hover/ic:text-white">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="6" /><path d="M10 9l5 3-5 3z" fill="#fff" /></svg>
                    </span>
                    <span class="text-[11px] font-bold text-[var(--color-cream-700)]">Ask video</span>
                  </a>
                )}
                <a
                  href={item.pageHref ?? item.href}
                  aria-label={`Learn more about ${item.title}`}
                  class="group/ic flex flex-col items-center gap-1.5 text-center"
                >
                  <span class="flex h-11 w-11 items-center justify-center rounded-full border-2 border-[var(--color-cream-200)] bg-white text-[var(--color-coral-600)] transition group-hover/ic:-translate-y-0.5 group-hover/ic:border-transparent group-hover/ic:bg-[var(--color-coral-500)] group-hover/ic:text-white">
                    <PawPrint class="h-[18px] w-[18px]" />
                  </span>
                  <span class="text-[11px] font-bold text-[var(--color-cream-700)]">Learn more</span>
                </a>
              </div>
            </div>
            ) : (
            <div class="mt-auto flex flex-col gap-3 pt-5">
            {item.video ? (
              <button
                type="button"
                data-video={item.video}
                data-video-title={item.title}
                aria-label={`Watch a video of ${item.title}`}
                class="js-video-open clay-btn-outline clay-press inline-flex w-full items-center justify-center gap-2 whitespace-nowrap bg-white px-5 py-2.5 text-sm font-bold text-[var(--color-coral-600)] transition-transform"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                Watch video
              </button>
            ) : (
              // Empty slot the exact size of the Watch-video button, so cards with
              // and without a video keep their Ask/Book buttons on the same row.
              <span aria-hidden="true" class="pointer-events-none invisible inline-flex w-full items-center justify-center border-2 px-5 py-2.5 text-sm font-bold">&nbsp;</span>
            )}
            <a
              href={item.href}
              data-wa-source={item.waSource}
              data-wa-variant={item.waVariant}
              aria-label={item.price ? `${item.meta}: ${item.title}, $${fmtPrice(item.price)} all-in` : `${item.meta}: ${item.title}`}
              class="clay-btn clay-press inline-flex w-full items-center justify-center gap-2 whitespace-nowrap bg-[#25D366] px-5 py-3 text-sm font-bold text-white transition-transform hover:bg-[#1ebe57]"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.13c-.25.7-1.44 1.33-1.99 1.37-.53.05-.53.42-3.34-.7-2.81-1.12-4.55-3.98-4.69-4.16-.14-.19-1.12-1.49-1.12-2.84 0-1.35.71-2.01.96-2.29.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.85 2.06.92 2.21.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.14-.28.28-.12.56.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.22 1.37.28.14.44.12.6-.07.16-.19.69-.81.88-1.09.19-.28.37-.23.62-.14.25.09 1.6.76 1.87.9.28.14.46.21.53.32.07.12.07.65-.18 1.35z" />
              </svg>
              {item.meta}
            </a>
            {item.pageHref && (
              <a
                href={item.pageHref}
                aria-label={`Learn more about ${item.title}`}
                class="clay-btn-outline clay-press inline-flex w-full items-center justify-center gap-2 whitespace-nowrap bg-white px-5 py-2.5 text-sm font-bold text-[var(--color-coral-600)] transition-transform"
              >
                Learn more
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            )}
            {item.bookHref && (
              <a
                href={item.bookHref}
                target="_blank"
                rel="noopener"
                aria-label={`Book an appointment to visit ${item.title}`}
                class="clay-btn-outline clay-press inline-flex w-full items-center justify-center gap-2 whitespace-nowrap bg-white px-5 py-2.5 text-sm font-bold text-[var(--color-coral-600)] transition-transform"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                Book Appointment
              </a>
            )}
            </div>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>

  {footerCtaLabel && footerCtaHref && (
    <div class="mt-9">
      <a href={footerCtaHref} class="clay-btn-outline inline-flex items-center gap-2 bg-white px-6 py-3 text-base font-bold text-[var(--color-coral-600)]">
        {footerCtaLabel}
      </a>
    </div>
  )}
</section>

{/* Shared video lightbox - Astro hoists this script once no matter how many
   ListingGrids render on the page. The modal is created lazily on first play. */}
<script>
  (function () {
    if ((window as any).__ctVideoLightbox) return;
    (window as any).__ctVideoLightbox = true;

    // Turn a raw sheet URL (YouTube, Google Drive, or direct file) into embeddable
    // HTML. `portrait` is true for vertical clips (YouTube Shorts) so the lightbox
    // frame can be sized 9:16 instead of 16:9.
    function embedFor(url: string, title: string): { html: string; portrait: boolean } {
      const isShort = /youtube\.com\/shorts\//.test(url);
      const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
      if (yt) {
        return { html: `<iframe src="https://www.youtube.com/embed/${yt[1]}?autoplay=1&rel=0&playsinline=1" title="${title}" allow="autoplay; encrypted-media; fullscreen" allowfullscreen class="h-full w-full"></iframe>`, portrait: isShort };
      }
      const drive = url.match(/drive\.google\.com\/file\/d\/([\w-]+)/);
      if (drive) {
        return { html: `<iframe src="https://drive.google.com/file/d/${drive[1]}/preview" title="${title}" allow="autoplay; fullscreen" allowfullscreen class="h-full w-full"></iframe>`, portrait: false };
      }
      if (/\.(mp4|webm|mov|m4v)(\?|$)/i.test(url)) {
        return { html: `<video src="${url}" controls autoplay playsinline class="h-full w-full bg-black"></video>`, portrait: false };
      }
      window.open(url, '_blank', 'noopener');
      return { html: '', portrait: false };
    }

    let overlay: HTMLElement | null = null;
    function close() {
      if (!overlay) return;
      overlay.classList.add('opacity-0');
      const frame = overlay.querySelector('.js-video-frame') as HTMLElement | null;
      setTimeout(() => {
        if (frame) frame.innerHTML = '';
        overlay?.classList.add('hidden');
      }, 150);
    }
    function open(url: string, title: string) {
      const { html, portrait } = embedFor(url, title);
      if (!html) return;
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.className =
          'fixed inset-0 z-[200] hidden items-center justify-center bg-black/80 p-4 opacity-0 transition-opacity duration-150';
        overlay.innerHTML =
          '<div class="js-video-wrap relative mx-auto"><button type="button" aria-label="Close video" class="js-video-close absolute -top-11 right-0 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-black hover:bg-white"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button><div class="js-video-frame w-full overflow-hidden rounded-2xl bg-black shadow-2xl"></div></div>';
        document.body.appendChild(overlay);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay || (e.target as HTMLElement).closest('.js-video-close')) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      }
      const wrap = overlay.querySelector('.js-video-wrap') as HTMLElement;
      const frame = overlay.querySelector('.js-video-frame') as HTMLElement;
      // Portrait (Shorts): a tall 9:16 box capped to the viewport height. Landscape:
      // a wide 16:9 box capped to a comfortable reading width.
      wrap.style.width = portrait ? 'min(92vw, calc(85vh * 9 / 16))' : 'min(92vw, 48rem)';
      frame.style.aspectRatio = portrait ? '9 / 16' : '16 / 9';
      frame.innerHTML = html;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      requestAnimationFrame(() => overlay?.classList.remove('opacity-0'));
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.js-video-open') as HTMLElement | null;
      if (!btn) return;
      e.preventDefault();
      const url = btn.getAttribute('data-video');
      if (url) open(url, btn.getAttribute('data-video-title') || 'Puppy video');
    });
  })();
</script>
