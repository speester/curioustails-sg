---
// Overseas (Australia) reservation puppies for a breed page, from
// src/data/overseas-puppies.json (npm run sync:overseas). These are import
// reservations: the puppy is in Australia now; the buyer pays a 50% deposit to
// begin the import and the balance before the puppy flies to Singapore.
// No source photo is available (the listing hosts block hotlinking), so cards
// use a branded placeholder and link to the original listing for photos.
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';
import PawPrint from './decor/PawPrint.astro';
import { fmtPrice } from '../data/pricing';
import { whatsappLink } from '../data/site';
import overseas from '../data/overseas-puppies.json';

interface Props {
  breed: string; // page slug
  breedName: string;
}
const { breed, breedName } = Astro.props;

interface OsPup {
  id: string; listingId: string | null; breedLabel: string; crossLabel: string | null;
  gender: 'Male' | 'Female' | 'Both' | null; age: string | null; canFly: boolean | null;
  price: number | null; deposit: number | null; image: string | null;
}
const photos = import.meta.glob<ImageMetadata>('../assets/overseas/*.webp', { eager: true, import: 'default' });
const imgFor = (file: string | null) => (file ? photos[`../assets/overseas/${file}`] : undefined);
// Owner decision 2026-09-30: only list an overseas reservation puppy when it has
// a real photo. Pups whose source image could not be fetched are hidden.
const pups = ((overseas.breeds as Record<string, OsPup[]>)[breed] ?? []).filter((p) => imgFor(p.image));
const genderWord = (g: OsPup['gender']) => (g === 'Female' ? 'Girl' : g === 'Male' ? 'Boy' : 'Puppy');
---

{pups.length > 0 && (
<section class="mx-auto max-w-[1400px] px-5 sm:px-8 py-16">
  <div class="max-w-[70ch]">
    <h2 class="font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
      Reserve a <span class="text-[var(--color-coral-500)]">{breedName}</span> from Australia
    </h2>
    <p class="mt-2 text-base text-[var(--color-cream-600)]">
      These {breedName} puppies are in Australia now, available for reservation only. Pay a 50% deposit and we begin the import process; the remaining 50% is due before your puppy flies to Singapore. Every price below is the all-in price to your door in Singapore.
    </p>
  </div>

  <ul class="mt-9 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {pups.map((p, i) => (
      <li>
        <div class={`clay flex h-full flex-col overflow-hidden bg-[var(--color-surface-card)] ${i % 2 === 0 ? '-rotate-1' : 'rotate-1'}`}>
          <div class="relative p-3 pb-0">
            <div class="overflow-hidden rounded-[1.1rem]">
              {imgFor(p.image) ? (
                <div class="aspect-[4/3] w-full overflow-hidden">
                  <Image src={imgFor(p.image)!} alt={`${p.crossLabel ?? breedName} puppy for reservation from Australia`} width={500} height={375} loading="lazy" class="h-full w-full object-cover" />
                </div>
              ) : (
                <PlaceholderImage alt={`${p.crossLabel ?? breedName} puppy for reservation from Australia`} ratio="aspect-[4/3]" />
              )}
            </div>
            <span class="absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-lilac-900)] px-2.5 py-1 text-xs font-bold text-white shadow-[0_3px_0_0_rgba(0,0,0,0.18)]">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
              In Australia · Reserve
            </span>
            {p.canFly && (
              <span class="absolute right-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-[var(--color-mint-100)] px-2.5 py-1 text-xs font-bold text-[var(--color-lilac-700)] shadow-[0_3px_0_0_rgba(0,0,0,0.12)]">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg>
                Ready to fly
              </span>
            )}
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="text-lg font-[family-name:var(--font-heading)] font-semibold text-[var(--color-cream-900)]">
              {p.crossLabel ?? breedName} {genderWord(p.gender)}
            </h3>
            {p.price != null && (
              <p class="mt-1 text-xl font-bold text-[var(--color-coral-600)]">
                ${fmtPrice(p.price)}<span class="ml-1 text-xs font-semibold text-[var(--color-cream-600)]">all-in to Singapore</span>
              </p>
            )}
            <ul class="mt-3.5 mb-4 space-y-2 border-t-2 border-dashed border-[var(--color-cream-200)] pt-3.5 text-sm text-[var(--color-cream-700)]">
              {p.deposit != null && (
                <li class="flex items-start gap-2.5"><PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />50% deposit to reserve: <span class="font-semibold">${fmtPrice(p.deposit)}</span></li>
              )}
              <li class="flex items-start gap-2.5"><PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />Balance due before your puppy flies over</li>
              {p.age && <li class="flex items-start gap-2.5"><PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />{p.age}</li>}
              <li class="flex items-start gap-2.5"><PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />{p.canFly ? 'Old enough to fly to Singapore now' : 'Flies to Singapore once 3 months old'}</li>
              {p.listingId && (
                <li class="flex items-start gap-2.5"><PawPrint class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--color-coral-400)]" />Listing ID: <span class="font-semibold">{p.listingId}</span></li>
              )}
            </ul>
            <a
              href={whatsappLink(`Hi! I'd like to reserve the ${p.crossLabel ?? breedName} puppy from Australia${p.listingId ? ` (Listing ID ${p.listingId})` : ''} (all-in $${p.price ? fmtPrice(p.price) : ''}). Can you tell me more about the import process?`)}
              data-wa-source={`overseas:${p.id}`}
              class="clay-btn clay-press mt-auto inline-flex w-full items-center justify-center gap-2 whitespace-nowrap bg-[#25D366] px-5 py-3 text-sm font-bold text-white transition-transform hover:bg-[#1ebe57]"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
              Reserve this puppy
            </a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
)}
