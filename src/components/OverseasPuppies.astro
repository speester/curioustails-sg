---
// Overseas (Australia) reservation puppies, from src/data/overseas-puppies.json
// (npm run sync:overseas). These are import reservations: the puppy is in
// Australia now; the buyer pays a 50% deposit to begin the import and the
// balance before the puppy flies to Singapore.
//
// Breed pages no longer use this standalone section: they render the merged
// ReservePuppies section (Irish + Australian cards under one heading). Kept for
// any other surface that wants the Australian list on its own.
import OverseasPuppyCard from './OverseasPuppyCard.astro';
import { SURCHARGE_LINE } from '../data/buying-terms';
import { overseasForBreed } from '../lib/overseas-puppies';

interface Props {
  breed: string; // page slug
  breedName: string;
}
const { breed, breedName } = Astro.props;
const pups = overseasForBreed(breed);
---

{pups.length > 0 && (
<section class="mx-auto max-w-[1400px] px-5 sm:px-8 py-16">
  <div class="max-w-[70ch]">
    <h2 class="font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
      Reserve a <span class="text-[var(--color-coral-500)]">{breedName}</span> from Australia
    </h2>
    <p class="mt-2 text-base text-[var(--color-cream-600)]">
      These {breedName} puppies are in Australia now, available for reservation only. Pay a 50% deposit and we begin the import process; the remaining 50% is due before your puppy flies to Singapore. Every price below is the all-in price to your door in Singapore.
    </p>
  </div>

  <ul class="mt-9 grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {pups.map((p, i) => (
      <li><OverseasPuppyCard p={p} breedName={breedName} index={i} /></li>
    ))}
  </ul>

  <p class="mt-7 text-sm leading-relaxed text-[var(--color-cream-600)]">All-in prices. {SURCHARGE_LINE}</p>
</section>
)}
