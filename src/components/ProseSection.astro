---
// kit:ProseSection@1.0.0 - structural typography for one H2 block of a long-form article.
// The .prose > h2 rhythm CSS works ONLY on DIRECT children - do not wrap H2s in a div.
interface Props { id?: string; heading: string; level?: 2 | 3; kicker?: string; }
const { id, heading, level = 2, kicker } = Astro.props as Props;
const H = `h${level}`;
---
<section class="prose-section" data-treatment="prose" id={id}>
  {kicker && <p class="prose-section__kicker">{kicker}</p>}
  <H class="prose-section__heading" id={id}>{heading}</H>
  <div class="prose"><slot /></div>
</section>

<style>
  .prose-section { position: relative; padding-block: clamp(2rem, 4vw, 3.5rem); }
  .prose-section__kicker { font-size: var(--text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-kicker); margin: 0 0 .5rem; }
  .prose-section__heading { position: relative; padding-top: .75rem; }
  .prose-section__heading::before { content: ''; position: absolute; top: 0; left: 0; width: 3.5rem; height: 3px; background: var(--color-accent); border-radius: 2px; }
  /* cycled H2 treatments - DIRECT children of .prose only */
  .prose > h2:nth-of-type(6n+1)::after { content: ''; display: block; width: 2rem; height: 2px; background: var(--color-accent); margin-top: .4rem; }
  .prose > h2:nth-of-type(6n+2) { border-left: 3px solid var(--color-accent); padding-left: .75rem; }
  .prose > h2:nth-of-type(6n+3) { text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: .35em; }
  .prose > h2:nth-of-type(6n+4)::before { content: '§'; color: var(--color-accent); margin-right: .4rem; }
  .prose > h2:nth-of-type(6n+5) { background: linear-gradient(transparent 62%, var(--surface-tint) 62%); display: inline; }
  .prose > h3 { position: relative; padding-left: 1rem; }
  .prose > h3::before { content: ''; position: absolute; left: 0; top: .55em; width: .5rem; height: .5rem; border-radius: 50%; background: var(--color-accent); }
</style>
