---
// Puppy Match Swiper — a Tinder-style "find your paw-fect match" widget.
// Ported from a design artifact, but driven by the REAL live inventory
// (src/data/available-puppies.json, Balestier-only) with optimised photos,
// real prices, HDB status, per-pup video + cal.com booking links — no base64.
// Self-contained + scoped under .pms so its generic class/token names cannot
// leak into (or be clobbered by) the rest of the site.
import data from '../data/available-puppies.json';
import { photoFor, type BreedBucket } from '../lib/puppy-cards';
import { breedName as displayBreedName } from '../data/breed-names';
import { site } from '../data/site';
import pawderLogo from '../assets/home/pawder-logo.webp';

const half = (g: string | null) => (g === 'Female' ? 'Girl' : g === 'Male' ? 'Boy' : 'Puppy');

type SwipePup = {
  name: string; breed: string; age: string; gender: string; price: number; priceStr: string;
  hdb: boolean; size: string; coat: string; color: string; origin: string; traits: string[];
  book: string; video: string; img: string;
};

const puppies: SwipePup[] = [];
for (const [slug, bucket] of Object.entries(data.breeds as Record<string, BreedBucket>)) {
  for (const p of bucket.available ?? []) {
    const meta = photoFor(p.image);
    if (!meta) continue; // only pups with a real photo
    const breed = (p.crossLabel ?? displayBreedName(slug)) as string;
    puppies.push({
      name: p.name ?? `${p.color ?? ''} ${half(p.gender)}`.trim(),
      breed,
      age: p.age ?? '',
      gender: p.gender === 'Female' ? 'f' : 'm',
      price: p.price ?? 0,
      priceStr: p.price ? `$${p.price.toLocaleString('en-SG')}` : 'Ask',
      hdb: !!p.hdbApproved,
      size: p.sizeNote ?? '',
      coat: '',
      color: p.color ?? '',
      origin: p.origin ?? '',
      traits: ['Vaccinated', 'Vet-checked'],
      book: p.bookHref ?? '',
      video: p.video ?? '',
      img: meta.src,
    });
  }
}
const META = { synced: data.syncedAt, count: puppies.length };
const WA = `65${site.whatsapp}`; // wa.me needs the +65 country code
---

{puppies.length > 0 && (
<section class="pms-section">
  <div class="pms">
    <div class="app" id="pmsApp">
      <div class="head">
        <div class="title">
          <img class="pms-logo" src={pawderLogo.src} width={pawderLogo.width} height={pawderLogo.height} alt="Pawder, find your paw-fect match at Curious Tails" />
        </div>
        <span class="counter" id="pmsCounter" hidden></span>
      </div>

      {/* intent intro — hidden by default; filters removed (owner 2026-10-03),
          the deck opens straight away. Kept in the DOM as a graceful fallback. */}
      <div class="intro" id="pmsIntro" hidden>
        <div>
          <h2>Let's find the right pup 😽</h2>
          <p class="lead" style="color:var(--ink-soft);font-weight:600;margin:6px 0 0;font-size:14px">Two quick taps so we only show puppies that fit your home.</p>
        </div>
        <div>
          <div class="q">Where will your puppy live?</div>
          <div class="opts" id="pmsHome">
            <button class="opt" data-home="hdb"><span class="em">🏠</span>HDB flat</button>
            <button class="opt" data-home="condo"><span class="em">🏢</span>Condo</button>
            <button class="opt" data-home="landed"><span class="em">🏡</span>Landed</button>
          </div>
        </div>
        <div>
          <div class="q">Budget?</div>
          <div class="opts" id="pmsBudget">
            <button class="opt" data-budget="3500">Up to $3.5k</button>
            <button class="opt" data-budget="4500">Up to $4.5k</button>
            <button class="opt" data-budget="99999">Any budget</button>
          </div>
        </div>
        <button class="start" id="pmsStart" disabled>Start swiping →</button>
      </div>

      {/* swipe stage */}
      <div class="stage" id="pmsStage">
        <div class="deck" id="pmsDeck"></div>
        <div class="controls" id="pmsControls">
          <button class="btn sm nope" id="pmsNope" aria-label="Pass">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
          <button class="btn sm undo" id="pmsUndo" aria-label="Undo" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg></button>
          <button class="btn big like" id="pmsLike" aria-label="Love">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></button>
        </div>
        <p class="hint">Drag or tap: ❤️ keep, ✖ pass</p>
      </div>
    </div>
  </div>
</section>
)}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" />

<script define:vars={{ PUPPIES: puppies, META, WA }}>
  (function(){
    "use strict";
    var root=document.querySelector(".pms");if(!root)return;
    var esc=function(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c];});};
    var $=function(id){return document.getElementById(id);};
    var reduce=window.matchMedia&&window.matchMedia("(prefers-reduced-motion:reduce)").matches;

    var home=null,budget=null;
    function bindOpts(wrap,attr,set){
      wrap.addEventListener("click",function(e){
        var b=e.target.closest(".opt");if(!b)return;
        [].forEach.call(wrap.children,function(c){c.setAttribute("aria-pressed","false");});
        b.setAttribute("aria-pressed","true");set(b.getAttribute("data-"+attr));
        $("pmsStart").disabled=!(home&&budget);
      });
    }
    bindOpts($("pmsHome"),"home",function(v){home=v;});
    bindOpts($("pmsBudget"),"budget",function(v){budget=+v;});
    $("pmsStart").addEventListener("click",function(){
      POOL=PUPPIES.filter(function(p){
        if(home==="hdb"&&!p.hdb)return false;
        if(p.price>budget)return false;return true;
      });
      if(!POOL.length)POOL=PUPPIES.slice();
      $("pmsIntro").hidden=true;$("pmsStage").hidden=false;$("pmsCounter").hidden=false;
      render(true);
    });

    var POOL=[],index=0,liked=[],history=[],animating=false;
    var deck=$("pmsDeck"),counter=$("pmsCounter"),controls=$("pmsControls"),
        bNope=$("pmsNope"),bLike=$("pmsLike"),bUndo=$("pmsUndo");

    function chipsHtml(p){
      var h='';
      if(p.hdb)h+='<span class="chip mint">&#10003; HDB-ok</span>';
      if(p.size)h+='<span class="chip">'+esc(p.size)+'</span>';
      if(p.coat)h+='<span class="chip lilac">'+esc(p.coat)+'</span>';
      (p.traits||[]).slice(0,2).forEach(function(t){h+='<span class="chip">'+esc(t)+'</span>';});
      return h;
    }
    function render(first){
      deck.innerHTML="";
      if(index>=POOL.length){renderEnd();counter.hidden=true;return;}
      counter.hidden=false;counter.textContent=(index+1)+" / "+POOL.length;
      var end=Math.min(index+3,POOL.length);
      for(var i=end-1;i>=index;i--){
        var p=POOL[i],pos=i-index;
        var card=document.createElement("div");
        card.className="card"+(pos===0?" top":"")+(pos===0&&p.video?" hasvid":"");
        card.style.transform="translateY("+(pos*-8)+"px) scale("+(1-pos*0.045)+")";
        card.style.zIndex=String(10-pos);
        card.style.opacity=pos<2?"1":"0";
        card.innerHTML=
          '<div class="photo"><img src="'+p.img+'" alt="'+esc(p.name)+', a '+esc(p.breed)+' puppy" draggable="false">'
          +'<div class="fade"></div>'
          +(p.hdb?'<span class="badge hdb">&#10003; HDB-approved</span>':'')
          +(p.video?'<a class="badge vid" href="'+esc(p.video)+'" target="_blank" rel="noopener">&#9654; Video</a>':'')
          +'<span class="gender" title="'+(p.gender==="f"?"Female":"Male")+'">'+(p.gender==="f"?"&#9792;":"&#9794;")+'</span>'
          +'<span class="stamp like">LOVE</span><span class="stamp nope">PASS</span>'
          +'<div class="onpic"><div class="nr"><h2>'+esc(p.name)+'</h2><span class="age">'+esc(p.age)+'</span></div>'
          +'<div class="br">'+esc(p.breed)+(p.color?' &middot; '+esc(p.color):'')+'</div></div></div>'
          +'<div class="tray"><div class="top-row"><span class="price">'+esc(p.priceStr)+'</span>'
          +(p.origin?'<span class="origin">'+esc(p.origin)+'</span>':'')+'</div>'
          +'<div class="chips">'+chipsHtml(p)+'</div></div>';
        deck.appendChild(card);
        if(pos===0){attachDrag(card);if(first&&!reduce&&index===0)card.classList.add("nudge");}
      }
    }
    function attachDrag(card){
      var sx=0,dx=0,drag=false,id=null;
      var like=card.querySelector(".stamp.like"),nope=card.querySelector(".stamp.nope");
      card.addEventListener("pointerdown",function(e){
        if(animating)return;if(e.target.closest("a"))return;
        drag=true;id=e.pointerId;sx=e.clientX;card.classList.remove("nudge");card.style.transition="none";
        try{card.setPointerCapture(id);}catch(_){}});
      card.addEventListener("pointermove",function(e){
        if(!drag||e.pointerId!==id)return;dx=e.clientX-sx;
        card.style.transform="translate("+dx+"px,"+(Math.abs(dx)*-0.05)+"px) rotate("+(dx*0.06)+"deg)";
        var r=Math.min(1,Math.abs(dx)/92);like.style.opacity=dx>0?r:0;nope.style.opacity=dx<0?r:0;});
      function up(e){if(!drag||e.pointerId!==id)return;drag=false;try{card.releasePointerCapture(id);}catch(_){}
        if(dx>92)fly(card,1);else if(dx<-92)fly(card,-1);
        else{card.style.transition="transform .3s var(--pop)";card.style.transform="translateY(0) scale(1)";like.style.opacity=0;nope.style.opacity=0;}}
      card.addEventListener("pointerup",up);card.addEventListener("pointercancel",up);
    }
    function fly(card,dir){
      animating=true;card.classList.remove("nudge");
      try{if(navigator.vibrate)navigator.vibrate(dir>0?[8,30,8]:12);}catch(_){}
      var off=(window.innerWidth||412)*1.15*dir;
      card.style.transition="transform .42s var(--pop)";
      card.style.transform="translate("+off+"px,-50px) rotate("+(dir*20)+"deg)";
      var s=card.querySelector(dir>0?".stamp.like":".stamp.nope");if(s)s.style.opacity=1;
      if(dir>0){heartBurst();}
      setTimeout(function(){commit(dir);},reduce?0:310);
    }
    function commit(dir){var p=POOL[index];history.push({index:index,liked:dir>0});
      if(dir>0){liked.push(p);}
      index++;bUndo.disabled=false;animating=false;render();}
    function swipe(dir){if(animating||index>=POOL.length)return;var c=deck.querySelector(".card.top");if(c)fly(c,dir);else commit(dir);}
    function undo(){if(!history.length||animating)return;var l=history.pop();index=l.index;if(l.liked)liked.pop();bUndo.disabled=history.length===0;render();}
    bNope.addEventListener("click",function(){swipe(-1);});
    bLike.addEventListener("click",function(){swipe(1);});
    bUndo.addEventListener("click",undo);
    document.addEventListener("keydown",function(e){
      if($("pmsStage").hidden)return;
      if(e.key==="ArrowLeft")swipe(-1);else if(e.key==="ArrowRight")swipe(1);
      else if((e.key==="z"||e.key==="Z")&&!bUndo.disabled)undo();});

    function heartBurst(){
      if(reduce)return;
      var cv=document.createElement("canvas");cv.className="pms-confetti";document.body.appendChild(cv);
      var ctx=cv.getContext("2d"),W=cv.width=innerWidth,H=cv.height=innerHeight;
      var cols=["#f0794a","#9fe0cb","#b9a7e0","#ffd24a","#ff6b8a"];
      var P=[];for(var i=0;i<46;i++){P.push({x:W/2,y:H*0.42,vx:(Math.random()-.5)*11,vy:Math.random()*-11-3,
        s:6+Math.random()*7,c:cols[i%cols.length],r:Math.random()*6,heart:Math.random()<.4});}
      var t=0;(function f(){t++;ctx.clearRect(0,0,W,H);
        P.forEach(function(p){p.vy+=.4;p.x+=p.vx;p.y+=p.vy;p.r+=.1;
          ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.fillStyle=p.c;
          if(p.heart){ctx.font=p.s*2+"px serif";ctx.fillText("❤",0,0);}
          else ctx.fillRect(-p.s/2,-p.s/2,p.s,p.s*.6);ctx.restore();});
        if(t<70)requestAnimationFrame(f);else cv.remove();})();
    }

    function waLink(list){
      var msg;
      if(!list.length)msg="Hi Curious Tails! I was using your puppy matcher, could you help me find a good fit for my home ("+homeLabel()+")?";
      else{var names=list.map(function(p){return p.name+" ("+p.breed+", "+p.priceStr+")";}).join(", ");
        msg="Hi Curious Tails! I used your puppy matcher (home: "+homeLabel()+") and I'd love to hear more about: "+names+". Are they still available?";}
      return "https://wa.me/"+WA+"?text="+encodeURIComponent(msg);
    }
    function homeLabel(){return home==="hdb"?"HDB flat":home==="condo"?"condo":home==="landed"?"landed":"home";}
    function waIcon(){return '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2zm5.7 14.1c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.8-.6-3.1-1.3-5.1-4.4-5.3-4.7-.2-.3-1.3-1.7-1.3-3.2s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5.2.6.8 2 .9 2.1.1.1.1.3 0 .5-.1.2-.1.3-.3.5l-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.2.7-.1.3.1 1.7.8 2 1 .3.1.5.2.5.3.1.2.1.6 0 1.3z"/></svg>';}
    function calIcon(){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>';}
    function freshness(){try{var d=new Date(META.synced);var day=d.toLocaleDateString("en-SG",{day:"numeric",month:"short"});return "Updated "+day;}catch(_){return "Updated daily";}}

    function renderEnd(){
      controls.style.display="none";$("pmsStage").querySelector(".hint").style.display="none";
      var end=document.createElement("div");end.className="end";
      var head,body;
      if(!liked.length){
        head='<div class="empty-ill">&#128054;</div><h2>No favourites yet?</h2>'
          +'<p class="lead">No pressure, swipe again, or just say hi and we\'ll help you find the right fit.</p>';
        body='<a class="wa-all" href="'+waLink([])+'" target="_blank" rel="noopener">'+waIcon()+'Chat with Curious Tails</a>'
          +'<div class="row2"><button class="ghost" id="pmsAgain">&#8634; Swipe again</button></div>';
      }else{
        var items=liked.map(function(p){return '<div class="sl"><span class="sl-dot"><img src="'+p.img+'" alt=""></span>'
          +'<span><div class="n">'+esc(p.name)+'</div><div class="b">'+esc(p.breed)+' &middot; '+esc(p.priceStr)+'</div></span>'
          +'<span class="acts"><a class="mini wa" title="WhatsApp about '+esc(p.name)+'" href="'+waLink([p])+'" target="_blank" rel="noopener">'+waIcon()+'</a>'
          +(p.book?'<a class="mini cal" title="Book a visit" href="'+esc(p.book)+'" target="_blank" rel="noopener">'+calIcon()+'</a>':'')+'</span></div>';}).join("");
        head='<h2>You\'ve got '+liked.length+' match'+(liked.length>1?'es':'')+'! &#127881;</h2>'
          +'<p class="lead">Send your shortlist and we\'ll confirm who\'s still available &amp; set up a visit.</p>';
        body='<div class="shortlist">'+items+'</div>'
          +'<a class="wa-all" href="'+waLink(liked)+'" target="_blank" rel="noopener">'+waIcon()+'Ask about all on WhatsApp</a>'
          +'<div class="row2"><button class="ghost" id="pmsShare">&#128228; Share</button><button class="ghost" id="pmsAgain">&#8634; Swipe again</button></div>';
      }
      var trust='<div class="trust"><span>&#9989; AVS-licensed</span><span class="dot"></span>'
        +'<span>'+META.count+' puppies available</span><span class="dot"></span><span>'+freshness()+'</span></div>';
      end.innerHTML=head+body+trust;
      deck.parentElement.insertBefore(end,deck);deck.hidden=true;
      var again=$("pmsAgain");if(again)again.addEventListener("click",reset);
      var share=$("pmsShare");if(share)share.addEventListener("click",doShare);
    }
    function doShare(){
      var names=liked.map(function(p){return p.name+" ("+p.breed+")";}).join(", ");
      var text="I found my puppy match"+(liked.length>1?"es":"")+" at Curious Tails 🐾 "+names+" · curioustails.sg";
      if(navigator.share){navigator.share({title:"My Curious Tails match",text:text,url:"https://curioustails.sg"}).catch(function(){});}
      else if(navigator.clipboard){navigator.clipboard.writeText(text).then(function(){toast("Copied! Paste to a friend");}).catch(function(){toast(text);});}
      else toast("Share: "+text);
    }
    var toastEl;
    function toast(msg){if(!toastEl){toastEl=document.createElement("div");toastEl.className="pms-toast";document.body.appendChild(toastEl);}
      toastEl.textContent=msg;toastEl.classList.add("show");setTimeout(function(){toastEl.classList.remove("show");},2600);}

    function reset(){
      var e=root.querySelector(".end");if(e)e.remove();
      deck.hidden=false;index=0;liked=[];history=[];animating=false;bUndo.disabled=true;
      controls.style.display="";$("pmsStage").querySelector(".hint").style.display="";render(true);
    }

    // Filters removed (owner 2026-10-03): open straight on the swipe deck with the
    // full live pool. homeLabel() falls back to "home" for the WhatsApp message.
    POOL=PUPPIES.slice();
    render(true);
  })();
</script>

<style is:global>
  /* Tokens + layout scoped under .pms so nothing leaks into the rest of the site. */
  .pms{
    --cream:#fdf6ee;--cream-mid:#fbe9d9;--card:#ffffff;--deep:#3b2f4a;
    --ink:#3a2b28;--ink-soft:#8c7a71;--on-deep:#fdf6ee;
    --border:#f0ddca;--border-strong:#e7c3a6;
    --coral:#f0794a;--coral-600:#da5f32;--coral-soft:#fdeadf;
    --mint:#9fe0cb;--mint-soft:#e4f6f0;--mint-ink:#17382f;
    --lilac:#b9a7e0;--lilac-soft:#efeafa;
    --like:#1f9d6b;--nope:#e24d5b;
    --sh-sm:0 1px 0 #fff inset,0 4px 10px rgba(120,80,60,.10);
    --sh-md:0 2px 0 rgba(255,255,255,.7) inset,0 12px 26px rgba(120,80,60,.16);
    --sh-lg:0 2px 0 rgba(255,255,255,.7) inset,0 22px 44px rgba(120,80,60,.20);
    --pop:cubic-bezier(.34,1.56,.64,1);
    color:var(--ink);
    font-family:"Nunito",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .pms *{box-sizing:border-box}
  .pms h1,.pms h2,.pms h3{font-family:"Fredoka","Nunito",sans-serif;margin:0;line-height:1.05;font-weight:600}
  .pms .app{width:100%;max-width:412px;margin-inline:auto;height:min(80vh,720px);display:flex;flex-direction:column}
  @media (min-width:900px){
    .pms .app{max-width:560px;height:min(82vh,780px)}
    .pms .card{max-width:480px!important}
    .pms .pms-logo{width:224px}
    .pms .intro{padding:34px 30px}
    .pms .intro h2{font-size:26px}
    .pms .opt{font-size:15px;padding:14px 10px}
    .pms .start{font-size:18px;padding:16px}
  }

  .pms .head{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:2px;margin-bottom:12px}
  .pms .pms-logo{display:block;width:clamp(150px,50%,192px);height:auto;margin:0 auto}
  .pms .counter{position:absolute;right:0;top:0;flex:none;font-family:"Fredoka",sans-serif;font-size:12px;color:var(--coral-600);
    font-weight:600;background:var(--coral-soft);padding:5px 11px;border-radius:999px;
    border:2px solid var(--border-strong);font-variant-numeric:tabular-nums}

  .pms .intro{flex:1;display:flex;flex-direction:column;justify-content:center;gap:18px;
    background:var(--card);border:3px solid var(--border);border-radius:1.8rem;box-shadow:var(--sh-md);padding:26px 22px}
  .pms .intro h2{font-size:22px}
  .pms .intro .q{font-family:"Fredoka",sans-serif;font-weight:600;font-size:13px;color:var(--ink-soft);margin-bottom:8px}
  .pms .opts{display:flex;gap:8px;flex-wrap:wrap}
  .pms .opt{flex:1;min-width:84px;font-family:"Fredoka",sans-serif;font-weight:500;font-size:14px;cursor:pointer;
    background:var(--cream-mid);border:2.5px solid var(--border-strong);border-radius:1rem;padding:12px 8px;
    color:var(--ink);text-align:center;transition:transform .12s var(--pop),background .15s,border-color .15s}
  .pms .opt:hover{transform:translateY(-2px)}
  .pms .opt[aria-pressed="true"]{background:var(--coral);border-color:var(--coral-600);color:#fff;box-shadow:var(--sh-sm)}
  .pms .opt .em{display:block;font-size:22px;margin-bottom:2px}
  .pms .start{margin-top:4px;font-family:"Fredoka",sans-serif;font-weight:600;font-size:17px;cursor:pointer;
    background:var(--coral);color:#fff;border:2.5px solid var(--coral-600);border-radius:1rem;padding:14px;
    box-shadow:var(--sh-md);transition:transform .12s var(--pop)}
  .pms .start:hover{transform:translateY(-2px)}.pms .start:active{transform:scale(.97)}
  .pms .start:disabled{opacity:.5;cursor:default;transform:none}

