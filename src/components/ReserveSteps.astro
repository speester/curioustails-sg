---
// K-119 C4/A6/I3/B5: the reserve-to-home journey as five numbered steps.
// Extracted from the home page's inline <ol> so every breed page can render the
// same steps, with one source (RESERVE_STEPS) for the copy.
import { RESERVE_STEPS } from '../data/buying-terms';

interface Props {
  heading?: string;
}
const { heading } = Astro.props;
---

{heading && (
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 pt-16 pb-8">
    <h2 class="font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">{heading}</h2>
  </div>
)}
<div class="bg-[var(--color-mint-100)] pb-16">
  <ol class="mx-auto max-w-[1400px] px-5 sm:px-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
    {RESERVE_STEPS.map((step, i) => (
      <li data-reveal style={`--i:${i}`} class="clay clay-hover bg-[var(--color-surface-card)] p-5">
        <span class="font-[family-name:var(--font-heading)] font-bold text-[var(--color-coral-500)]" style="font-size: clamp(2rem, 3vw, 2.75rem); line-height: 1;">
          {String(i + 1).padStart(2, '0')}
        </span>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-cream-700)]">{step}</p>
      </li>
    ))}
  </ol>
</div>
