---
// Per-breed Google-review slider: real customer photo + avatar + stars + verbatim
// quote, in a modern card with Google branding and prev/next controls. Photo
// reviews only (reviewsWithPhotosFor). Used on breed and money pages.
import PlaceholderImage from './PlaceholderImage.astro';
import { reviewsWithPhotosFor } from '../data/review-wall';
import { site } from '../data/site';

interface Props {
  slug: string;
  heading?: string;
  subhead?: string;
  count?: number;
}
const {
  slug,
  heading = 'What Owners Say About Us',
  subhead = `${site.reviews.count} Google reviews, ${site.reviews.rating.toFixed(1)} average, and counting.`,
  count = 8,
} = Astro.props;

const media = import.meta.glob<ImageMetadata>('../assets/reviews/*.webp', { eager: true, import: 'default' });
const asset = (file: string | null | undefined) => (file ? media[`../assets/reviews/${file}`] : undefined);
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase() ?? '').join('');

const reviews = reviewsWithPhotosFor(slug, count);
const sid = `rs-${slug.replace(/[^a-z0-9]+/gi, '-')}`;
---

<section class="mx-auto max-w-[1400px] px-5 sm:px-8 py-16" data-review-slider={sid}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-[60ch]">
      <div class="mb-3 flex items-center gap-2">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38z"/></svg>
        <span class="text-sm font-bold text-[var(--color-cream-700)]">Google Reviews · {site.reviews.rating.toFixed(1)} ★</span>
      </div>
      <h2 class="font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">{heading}</h2>
      {subhead && <p class="mt-2 text-base text-[var(--color-cream-600)]">{subhead}</p>}
    </div>
    <div class="hidden items-center gap-2 sm:flex">
      <button type="button" data-rs-prev class="clay-btn-outline flex h-11 w-11 items-center justify-center bg-white text-[var(--color-cream-700)] transition-colors hover:text-[var(--color-coral-600)]" aria-label="Previous review">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" data-rs-next class="clay-btn-outline flex h-11 w-11 items-center justify-center bg-white text-[var(--color-cream-700)] transition-colors hover:text-[var(--color-coral-600)]" aria-label="Next review">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <ul data-rs-track class="mt-8 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4 pt-2 no-scrollbar" aria-label="Customer reviews with photos">
    {reviews.map((r) => (
      <li class="snap-start shrink-0 w-[86%] sm:w-[380px]">
        <article class="relative flex h-full flex-col rounded-[1.5rem] border border-[var(--color-cream-200)] bg-[var(--color-surface-card)] shadow-[0_10px_30px_-12px_rgba(0,0,0,0.18)] transition-transform duration-300 hover:-translate-y-1">
          <div class="overflow-hidden rounded-t-[1.5rem]">
            <PlaceholderImage src={asset(r.photos[0])} alt={`Puppy photo from ${r.name}, a Curious Tails customer`} ratio="aspect-[4/3]" sizes="(max-width: 639px) 86vw, 380px" />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-center gap-3">
              {asset(r.avatar) ? (
                <img src={asset(r.avatar)!.src} alt="" width="44" height="44" loading="lazy" decoding="async" class="h-11 w-11 shrink-0 rounded-full border-2 border-[var(--color-cream-200)] object-cover" />
              ) : (
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--color-lilac-100)] text-sm font-bold text-[var(--color-lilac-700)]" aria-hidden="true">{initials(r.name)}</span>
              )}
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-bold text-[var(--color-cream-900)]">{r.name}</p>
                <p class="text-xs text-[var(--color-cream-500)]">{r.timeAgo}{r.localGuide ? ' · Local Guide' : ''}</p>
              </div>
              <svg width="20" height="20" viewBox="0 0 24 24" aria-label="Google" class="shrink-0"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38z"/></svg>
            </div>
            <div class="mt-3 flex gap-0.5 text-[#FBBC05]" aria-label={`${r.rating ?? 5} out of 5`}>
              {Array.from({ length: r.rating ?? 5 }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01z"/></svg>
              ))}
            </div>
            {r.quote && (
              <blockquote class="mt-3 line-clamp-6 text-sm leading-relaxed text-[var(--color-cream-700)]">{r.quote}</blockquote>
            )}
            <a href={r.url} rel="noopener nofollow" target="_blank" class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-accent-hover)] underline underline-offset-2">
              Read on Google
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      </li>
    ))}
  </ul>

  <div class="mt-4">
    <a href="/reviews/" class="clay-btn-outline inline-flex items-center gap-2 bg-white px-5 py-3 text-sm font-bold text-[var(--color-coral-600)]">See all {site.reviews.count} reviews →</a>
  </div>
</section>

<script>
  document.querySelectorAll('[data-review-slider]').forEach((sec) => {
    const track = sec.querySelector('[data-rs-track]') as HTMLElement | null;
    if (!track) return;
    const step = () => Math.max(280, track.clientWidth * 0.8);
    sec.querySelector('[data-rs-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    sec.querySelector('[data-rs-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>
