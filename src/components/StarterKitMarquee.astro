---
// Infinite auto-scrolling rail of the real $500+ starter-kit items, so buyers
// can FEEL the value that a bullet list flattens. Items + prices + photos come
// from src/data/starter-kit-items.json (npm run sync:starter-kit). Full-bleed,
// edge-to-edge; no Section wrapper so no auto section-divider is emitted.
import { Image } from 'astro:assets';
import kit from '../data/starter-kit-items.json';

interface Props {
  subhead?: string;
}
const {
  subhead = 'The kit that comes home with your puppy - 30+ items across 8 categories, worth $500+ at pet shops, included free with every Curious Tails puppy.',
} = Astro.props;

const photos = import.meta.glob<ImageMetadata>('../assets/starter-kit/*.webp', {
  eager: true,
  import: 'default',
});
const imgFor = (file: string) => photos[`../assets/starter-kit/${file}`];

const items = (kit.items as { title: string; price: number | null; category: string | null; image: string }[])
  .filter((i) => imgFor(i.image));
const total = items.reduce((n, i) => n + (i.price ?? 0), 0);
const track = [...items, ...items];
---

<section class="w-full overflow-hidden bg-[var(--color-surface)] py-14 sm:py-20" data-tone="paper" data-treatment="rail">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-[60ch]">
        <h2 class="font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
          The <span class="text-[var(--color-coral-500)]">$500+ Starter Kit</span>, Free With Every Puppy
        </h2>
        {subhead && <p class="mt-2 text-base text-[var(--color-cream-600)]">{subhead}</p>}
      </div>
      <a href="/starter-kit/" class="clay-btn-outline inline-flex items-center gap-2 bg-white px-5 py-3 text-sm font-bold text-[var(--color-coral-600)]">
        See every item →
      </a>
    </div>
  </div>

  <div class="ct-marquee mt-10" aria-label={`Starter kit items, ${items.length} pieces worth $${total} in total`}>
    <ul class="ct-marquee__track">
      {track.map((item, i) => (
        <li class="ct-marquee__card" aria-hidden={i >= items.length ? 'true' : undefined}>
          <div class="clay flex h-full w-[230px] flex-col overflow-hidden bg-[var(--color-surface-card)] p-3.5">
            <div class="relative overflow-hidden rounded-[1.15rem]">
              <Image src={imgFor(item.image)} alt={item.title} width={280} height={280} loading="lazy" class="aspect-square w-full object-cover" />
              {item.price != null && (
                <span class="absolute right-3 top-3 inline-flex items-center rounded-full bg-[var(--color-coral-500)] px-2.5 py-1 text-xs font-bold text-white shadow-[0_3px_0_0_var(--color-coral-700)]">${item.price}</span>
              )}
            </div>
            {item.category && (
              <span class="mt-3 inline-flex w-fit rounded-full bg-[var(--color-mint-100)] px-2.5 py-0.5 text-[0.7rem] font-bold uppercase tracking-wide text-[var(--color-lilac-700)]">{item.category}</span>
            )}
            <p class="mt-1.5 line-clamp-2 text-base font-semibold leading-snug text-[var(--color-cream-900)]">{item.title}</p>
            <p class="mt-auto pt-1.5 text-xs font-bold text-[var(--color-coral-600)]">Included free</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ct-marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  }
  .ct-marquee__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding-inline: 1.25rem;
    /* room so the clay drop-shadow under each card is not clipped by the
       marquee's overflow:hidden (owner report 2026-09-29: shadow touching cards). */
    padding-block: 0.75rem 2rem;
    animation: ct-marquee-scroll 70s linear infinite;
  }
  .ct-marquee:hover .ct-marquee__track,
  .ct-marquee:focus-within .ct-marquee__track { animation-play-state: paused; }
  .ct-marquee__card { flex: 0 0 auto; }
  @keyframes ct-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct-marquee { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .ct-marquee__track { animation: none; }
  }
</style>
