---
// §7 Final CTA. AV · IMP · PL. Always on. id="final" is what the sticky bar watches.
import { finalCopy, wa, bookLink } from '../../data/puppy-page-copy';
import type { PuppyPageData } from '../../lib/puppy-page';

interface Props { p: PuppyPageData }
const { p } = Astro.props;
const c = finalCopy(p);
const book = bookLink(p);
---
<section class="final" aria-labelledby="final-h" id="final" data-section="final" data-treatment="callout" data-tone="paper">
  <div class="wrap">
    <div class="clay box" data-reveal>
      <span class="kicker">Ready when you are</span>
      <h2 id="final-h" style="margin-top:8px">{c.heading}</h2>
      <p>{c.body}</p>
      <div class="ctas">
        {p.variant === 'av' && (
          <>
            <a class="btn btn--wa" href={wa.final(p)} data-wa-source={`${p.waSource}:final`}>Check availability on WhatsApp</a>
            <a class="btn btn--ghost" href={book.href} target={book.external ? '_blank' : undefined} rel={book.external ? 'noopener' : undefined} data-card-action={book.external ? 'book' : undefined}>Book a viewing</a>
          </>
        )}
        {p.variant === 'pl' && (
          <>
            <a class="btn btn--wa" href={wa.soldFinal(p)} data-wa-source={`${p.waSource}:final`}>Ask about a similar {p.breedNoun}</a>
            <a class="btn btn--ghost" href="/available-puppies/">Browse all puppies</a>
          </>
        )}
        {p.variant === 'imp' && (
          <>
            <a class="btn btn--wa" href={wa.impReserve(p)} data-wa-source={`${p.waSource}:final`}>{p.imp?.reserved ? 'Ask about the next one' : 'Reserve on WhatsApp'}</a>
            <a class="btn btn--ghost" href="/available-puppies/">See every puppy available now</a>
          </>
        )}
      </div>
    </div>
  </div>
</section>
