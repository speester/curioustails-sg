---
// kit:floating-multi-image@1.0.0 - SEED section pattern (contracts 22). Tier A.
// axis tuple: overlap-layers/none/hero-plus-small/gutter/photo/drift/photo/photo
// evidence:   photo
//
// Two to four photographs at deliberate offsets, drifting on a slow loop. The offsets are
// the design; the drift is 0.8rem of travel and exists only to keep the block from
// reading as a dead collage.
//
// SEED means FLOOR, not answer: Stage 2 STEP 3 restyles this to the project's tokens, and
// a site whose patterns are all unmodified copies of this library fails the novelty gate
// (audit_built_html.py --sections -> patterns_verbatim_kit). Every value below is a token.
interface Props {
  items?: Array<Record<string, string>>;
  heading?: string;
  class?: string;
}
const { items = [], heading, class: cls = '' } = Astro.props as Props;
---

<div class:list={['floaters', cls]} data-section-pattern="floating-multi-image" data-pattern-evidence="photo">
  {items.map((it, i) => (
    <figure class={`floaters__item floaters__item--${i % 3}`}>
      <img src={it.src} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" />
      {it.caption && <figcaption>{it.caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .floaters {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
    align-items: start;
  }
  .floaters__item { margin: 0; grid-column: span 6; }
  .floaters__item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 1rem);
    box-shadow: var(--shadow-md, 0 6px 20px rgb(0 0 0 / 0.10));
  }
  .floaters figcaption {
    margin-block-start: 0.5rem;
    font-size: var(--text-sm, 0.875rem);
    opacity: 0.8;
  }
  /* The composition only offsets from 60rem up: on a phone these are three stacked photos
     and any "float" is a wobble in a single column. */
  @media (min-width: 60rem) {
    .floaters__item--0 { grid-column: 1 / span 4; }
    .floaters__item--1 { grid-column: 4 / span 3; margin-block-start: 3rem; }
    .floaters__item--2 { grid-column: 2 / span 3; margin-block-start: -1.5rem; }
    .floaters__item img { animation: drift 9s ease-in-out infinite alternate; }
    .floaters__item--1 img { animation-duration: 11s; animation-delay: -3s; }
    .floaters__item--2 img { animation-duration: 13s; animation-delay: -6s; }
  }
  @keyframes drift {
    from { transform: translateY(-0.4rem); }
    to   { transform: translateY(0.4rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .floaters__item img { animation: none; }
  }
</style>
