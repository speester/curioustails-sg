---
// kit:image-carousel@1.0.0 - SEED section pattern (contracts 22). Tier B.
// axis tuple: horizontal-rail/none/equal-row/gutter/photo/none/photo/photo
// evidence:   photo
//
// A horizontal rail of photographs on scroll-snap. No carousel library, and no auto-
// rotation: an auto-rotating rail moves the thing a reader was looking at, and on a
// money page it moves the offer.
//
// SEED means FLOOR, not answer: Stage 2 STEP 3 restyles this to the project's tokens, and
// a site whose patterns are all unmodified copies of this library fails the novelty gate
// (audit_built_html.py --sections -> patterns_verbatim_kit). Every value below is a token.
interface Props {
  items?: Array<Record<string, string>>;
  heading?: string;
  class?: string;
}
const { items = [], heading, class: cls = '' } = Astro.props as Props;
---

<div class:list={['rail', cls]} data-section-pattern="image-carousel" data-pattern-evidence="photo" data-rail>
  {heading && <h3 class="rail__heading">{heading}</h3>}
  
  <div class="rail__track" tabindex="0" role="group" aria-label={heading ?? 'Scrollable items'} data-rail-track>
    {items.map((it) => (
      <figure class="rail__item">
        <img src={it.src} alt={it.alt} width={it.width} height={it.height} loading="lazy" decoding="async" />
        {it.caption && <figcaption>{it.caption}</figcaption>}
      </figure>
    ))}
  </div>
  <div class="rail__controls" hidden data-rail-controls>
    <div class="rail__dots">
      {items.map((_, i) => (
        <button type="button" class="rail__dot" data-rail-dot aria-label={`Go to item ${i + 1}`}></button>
      ))}
    </div>
    <button type="button" class="rail__btn" data-rail-prev aria-label="Previous">&#8592;</button>
    <button type="button" class="rail__btn" data-rail-next aria-label="Next">&#8594;</button>
  </div>
</div>

<style>
  .rail { position: relative; }
  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(min(80%, 18rem), 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    padding-block-end: 0.75rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .rail__item { scroll-snap-align: start; margin: 0; }
  .rail__item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md, 0.75rem);
  }
  .rail__card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: var(--radius-lg, 1rem);
    border: 1px solid var(--border-subtle, color-mix(in oklab, currentColor 12%, transparent));
    background: var(--surface-panel, color-mix(in oklab, currentColor 4%, transparent));
  }
  .rail__controls {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: flex-end;
    margin-block-start: 0.75rem;
  }
  .rail__btn {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle, color-mix(in oklab, currentColor 20%, transparent));
    background: var(--surface-panel, transparent);
    color: inherit;
    cursor: pointer;
  }
  .rail__dots { display: flex; gap: 0.35rem; margin-inline-end: auto; }
  .rail__dot {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in oklab, currentColor 25%, transparent);
    cursor: pointer;
  }
  .rail__dot[aria-current='true'] { background: var(--color-accent, currentColor); }
  @media (prefers-reduced-motion: reduce) { .rail__track { scroll-behavior: auto; } }
</style>
