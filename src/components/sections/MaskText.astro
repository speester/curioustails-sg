---
// kit:MaskText@1.0.0 - SEED section pattern (contracts 22). Tier A.
// axis tuple: full-bleed/none/single/flat/letterform/none/photo/definition
// evidence:   definition
//
// A headline filled with an image or a gradient. The @supports guard is not decoration:
// without it, a browser that ignores background-clip paints transparent text on a
// transparent ground and the headline disappears entirely.
//
// SEED means FLOOR, not answer: Stage 2 STEP 3 restyles this to the project's tokens, and a
// site whose patterns are all unmodified copies fails the novelty gate.
interface Props { media?: string; class?: string; }
const { media, class: cls = '' } = Astro.props as Props;
---

<h2 class:list={['maskt', cls]} data-section-pattern="mask-text" data-pattern-evidence="definition"
    style={media ? `--mask-media:url(${media})` : undefined}>
  <slot />
</h2>

<style>
  .maskt {
    margin: 0;
    color: var(--ink, currentColor);
    font-size: clamp(2rem, 7vw, 4.5rem);
    line-height: 1.02;
  }
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .maskt {
      background-image: var(--mask-media,
        linear-gradient(100deg, var(--color-accent, currentColor), var(--ink, currentColor)));
      background-size: cover;
      background-position: center;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }
</style>