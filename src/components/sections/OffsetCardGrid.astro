---
// kit:OffsetCardGrid@1.0.0 - SEED section pattern (contracts 22). Tier A.
// axis tuple: offset-grid/elevated-card/staggered/flat/numeral/reveal/flat/step
// evidence:   step
//
// The staggered numbered-card grid from the reference screenshots. It is an ORDERED LIST:
// the numerals are counters on <li>, not text in a <span>, so the sequence survives a
// screen reader and the offsets collapse to a single column under 48rem.
//
// SEED means FLOOR, not answer: Stage 2 STEP 3 restyles this to the project's tokens, and a
// site whose patterns are all unmodified copies fails the novelty gate.
interface Props {
  items?: Array<Record<string, string>>;
  heading?: string;
  class?: string;
}
const { items = [], heading, class: cls = '' } = Astro.props as Props;
---

<ol class:list={['ocg', cls]} data-section-pattern="card-grid-offset" data-pattern-evidence="step">
  {items.map((it) => (
    <li class="ocg__item" data-card data-reveal>
      <h4 class="ocg__title">{it.title}</h4>
      <p class="ocg__lead">{it.lead}</p>
    </li>
  ))}
</ol>

<style>
  .ocg {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    counter-reset: ocg;
  }
  @media (min-width: 48rem) { .ocg { grid-template-columns: 1fr 1fr; } }
  .ocg__item {
    counter-increment: ocg;
    position: relative;
    max-width: 34rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius-lg, 1rem);
    background: var(--surface-panel, color-mix(in oklab, currentColor 4%, transparent));
    box-shadow: var(--shadow-sm, 0 1px 2px rgb(0 0 0 / 0.06));
  }
  .ocg__item::before {
    content: counter(ocg, decimal-leading-zero);
    position: absolute;
    inset-block-start: -0.9rem;
    inset-inline-end: 1.25rem;
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: 999px;
    background: var(--color-accent, currentColor);
    color: var(--ink-onaccent, #fff);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm, 0.875rem);
  }
  /* The stagger is the pattern, and it only exists where there are two columns. */
  @media (min-width: 48rem) {
    .ocg__item:nth-child(even) { margin-block-start: 3.5rem; }
  }
  .ocg__title { margin: 0 0 0.4rem; }
  .ocg__lead { margin: 0; }
  @supports (animation-timeline: view()) {
    .ocg__item { animation: lift 1ms linear both; animation-timeline: view(); animation-range: entry 5% entry 45%; }
  }
  .ocg__item.is-revealed { animation: lift 460ms var(--ease-out, ease) both; }
  @keyframes lift { from { opacity: 0.001; transform: translateY(1.25rem); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .ocg__item, .ocg__item.is-revealed { animation: none; opacity: 1; transform: none; }
  }
</style>