---
// kit:QuoteFeature@1.0.0 - SEED section pattern (contracts 22). Tier A.
// axis tuple: editorial-columns/bracket/single/ruled/letterform/none/flat/quote
// evidence:   quote
//
// A pull-quote as a whole section, with attribution and the disclosure of who the source
// is. The oversized mark is a pseudo-element and aria-hidden by construction, so the
// quotation is read once, not twice.
//
// SEED means FLOOR, not answer: Stage 2 STEP 3 restyles this to the project's tokens, and a
// site whose patterns are all unmodified copies fails the novelty gate.
interface Props {
  quote: string; who: string; role?: string; source?: string; cite?: string; class?: string;
}
const { quote, who, role, source, cite, class: cls = '' } = Astro.props as Props;
---

<figure class:list={['qfeat', cls]} data-section-pattern="quote-feature" data-pattern-evidence="quote">
  <blockquote class="qfeat__quote" cite={cite}>
    <p>{quote}</p>
  </blockquote>
  <figcaption class="qfeat__by">
    <span class="qfeat__who">{who}</span>
    {role && <span class="qfeat__role">{role}</span>}
    {source && <span class="qfeat__src">{source}</span>}
    {cite && <a class="qfeat__link" href={cite} rel="nofollow noopener" target="_blank">See the source</a>}
  </figcaption>
</figure>

<style>
  .qfeat {
    margin: 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border-inline-start: 3px solid var(--color-accent, currentColor);
    background: var(--surface-panel, color-mix(in oklab, currentColor 3%, transparent));
    border-radius: 0 var(--radius-lg, 1rem) var(--radius-lg, 1rem) 0;
  }
  @media (min-width: 60rem) { .qfeat { grid-template-columns: 1.5fr 1fr; align-items: start; } }
  .qfeat__quote { margin: 0; position: relative; }
  .qfeat__quote::before {
    content: '\201C';
    position: absolute;
    inset-block-start: -1.5rem;
    inset-inline-start: -0.4rem;
    font-family: var(--font-display, serif);
    font-size: 6rem;
    line-height: 1;
    color: var(--surface-accent-soft, color-mix(in oklab, var(--color-accent, currentColor) 30%, transparent));
    z-index: 0;
  }
  .qfeat__quote p {
    position: relative;
    margin: 0;
    font-family: var(--font-display, inherit);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.3;
  }
  .qfeat__by { display: grid; gap: 0.25rem; font-size: var(--text-sm, 0.875rem); }
  .qfeat__who { font-weight: 600; }
  .qfeat__role, .qfeat__src { opacity: 0.8; }
</style>