---
// kit:TextNotation@1.0.0 - SEED section pattern (contracts 22). Tier A.
// axis tuple: (inline) - an EMPHASIS device used inside another pattern
// evidence:   none
//
// A hand-drawn circle, underline or strike over a phrase, drawn on view. The SVG is
// aria-hidden and sits BEHIND the text: the mark is emphasis, and a screen reader that
// announces a squiggle has been told a decoration is content.
//
// SEED means FLOOR, not answer: Stage 2 STEP 3 restyles this to the project's tokens, and a
// site whose patterns are all unmodified copies fails the novelty gate.
interface Props { variant?: 'circle' | 'underline' | 'strike'; class?: string; }
const { variant = 'circle', class: cls = '' } = Astro.props as Props;
---

<span class:list={['nota', `nota--${variant}`, cls]} data-reveal>
  <slot />
  <svg class="nota__mark" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    {variant === 'circle' && (
      <path d="M20 30 C20 8, 180 6, 182 30 C184 54, 22 56, 18 32" pathLength="1" />
    )}
    {variant === 'underline' && (
      <path d="M6 48 C60 40, 140 52, 194 42" pathLength="1" />
    )}
    {variant === 'strike' && (
      <path d="M6 32 C70 26, 130 38, 194 28" pathLength="1" />
    )}
  </svg>
</span>

<style>
  .nota { position: relative; display: inline-block; }
  .nota__mark {
    position: absolute;
    inset: -0.35em -0.5em;
    width: calc(100% + 1em);
    height: calc(100% + 0.7em);
    overflow: visible;
    z-index: -1;
  }
  .nota__mark path {
    fill: none;
    stroke: var(--color-accent, currentColor);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  @supports (animation-timeline: view()) {
    .nota__mark path {
      animation: draw 1ms linear both;
      animation-timeline: view();
      animation-range: entry 20% entry 80%;
    }
  }
  .nota.is-revealed .nota__mark path {
    animation: draw 700ms var(--ease-out, ease) both;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  /* Reduced motion shows the mark ALREADY DRAWN - the emphasis survives, the drawing does
     not. Killing the animation without this leaves an invisible stroke. */
  @media (prefers-reduced-motion: reduce) {
    .nota__mark path { animation: none; stroke-dashoffset: 0; }
  }
</style>