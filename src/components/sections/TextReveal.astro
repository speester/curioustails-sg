---
// kit:TextReveal@1.0.0 - SEED section pattern (contracts 22). Tier A (Tier B fallback).
// axis tuple: full-bleed/none/single/flat/letterform/reveal/photo/definition
// evidence:   definition
//
// A heading whose words wipe up as the section enters view. THE TEXT IS ALWAYS PRESENT: the
// finished state is the CSS default and the animation runs FROM a transform, so with the
// island blocked, the observer stalled, or scroll timelines unsupported, a reader sees the
// finished headline rather than an empty band. That inversion is the whole trick.
interface Props {
  text: string;
  media?: string;
  alt?: string;
  /** REQUIRED with `media`: an <img> with no intrinsic size is a CLS defect, and the
   *  audit measures width/height on every image on the built page. */
  width?: number;
  height?: number;
  class?: string;
}
const { text, media, alt = '', width, height, class: cls = '' } = Astro.props as Props;
const words = text.split(/\s+/);
---

<div class:list={['reveal', cls]} data-section-pattern="image-text-reveal" data-pattern-evidence="definition" data-reveal>
  {media && <img class="reveal__media" src={media} alt={alt} width={width} height={height} loading="lazy" decoding="async" />}
  <h2 class="reveal__text">
    {words.map((w, i) => (
      <span class="reveal__word" style={`--i:${i}`}><span class="reveal__inner">{w}</span></span>
    ))}
  </h2>
</div>

<style>
  .reveal { position: relative; }
  .reveal__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    border-radius: var(--radius-lg, 1rem);
  }
  .reveal__text {
    position: relative;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
  }
  .reveal__word { overflow: hidden; display: inline-block; }
  .reveal__inner { display: inline-block; }

  /* Scroll-driven where supported: no JS at all. */
  @supports (animation-timeline: view()) {
    .reveal__inner {
      animation: rise 1ms linear both;
      animation-timeline: view();
      animation-range: entry 10% entry 70%;
      animation-delay: calc(var(--i) * 1ms);
    }
  }
  /* The island's fallback: hidden ONLY once it has confirmed it can reveal again. */
  .reveal[data-reveal]:not(.is-revealed) .reveal__inner { transform: translateY(0); }
  .reveal.is-revealed .reveal__inner {
    animation: rise 520ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
    animation-delay: calc(var(--i) * 45ms);
  }
  @keyframes rise {
    from { transform: translateY(105%); }
    to   { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal__inner, .reveal.is-revealed .reveal__inner { animation: none; transform: none; }
  }
</style>
