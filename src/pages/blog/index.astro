---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BannerRibbon from '../../components/BannerRibbon.astro';
import FinalCta from '../../components/FinalCta.astro';
import Schema from '../../components/Schema.astro';
import PawTrail from '../../components/decor/PawTrail.astro';
import Blob from '../../components/decor/Blob.astro';
import PawPrint from '../../components/decor/PawPrint.astro';
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import { localBusinessSchema, personSchema, webPageSchema, itemListSchema } from '../../lib/schema';
import mistakesImg from '../../assets/home/5-cavapoo-puppy-settling-playpen-first-day.webp';
import hdbImg from '../../assets/bichonpoo/2-bichonpoo-white-portrait.webp';
import compareImg from '../../assets/cavapoo/2-cavapoo-puppy-portrait-available.webp';
import fireworksImg from '../../assets/puppy-fireworks-singapore/1-puppy-fireworks-safe-room-playpen-den.webp';
import firstNightImg from '../../assets/guides/3-puppy-night-routine-sleeping-pen.webp';
import courseImg from '../../assets/guides/6-puppy-microchip-scan-health.webp';
import ftoHubImg from '../../assets/guides/1-first-time-dog-owner-guide-hero.webp';
import learnHubImg from '../../assets/guides/5-verify-seller-phone-check-puppy.webp';

const title = 'Blog: Puppy Guides & Honest Advice | Curious Tails';
const description =
  'Honest puppy advice from the Curious Tails shop floor: first-timer mistakes, HDB breed guidance, and breed comparisons, written from real Singapore placements.';

// One entry per post. Newest first; add new posts to the top.
const posts = [
  {
    title: 'Pet Ownership Course Singapore: Your First Legal Step',
    href: '/blog/pet-ownership-course-singapore/',
    date: '2026-07-25',
    tag: 'Licensing',
    excerpt:
      'The free AVS course every first-time dog owner has to finish before a licence is issued: what is inside it, the two ways in, and when to do it so it never delays your puppy.',
    image: courseImg,
    imageAlt: 'Puppy microchip scan in Singapore, the step that comes before the dog licence application',
  },
  {
    title: "Surviving Your Puppy's First Night at Home",
    href: '/blog/puppy-first-night/',
    date: '2026-07-19',
    tag: 'Puppy care',
    excerpt:
      'What actually happens on night one: the crying window, the playpen setup, and the boring 2am toilet trip that keeps a bad habit from starting.',
    image: firstNightImg,
    imageAlt: 'Puppy asleep in its dim playpen with a comfort toy during its first night home',
  },
  {
    title: 'Getting Your Puppy Through NDP and New Year Fireworks',
    href: '/blog/puppy-fireworks-singapore/',
    date: '2026-07-18',
    tag: 'First-time owners',
    excerpt:
      'Why fireworks terrify puppies, the covered-playpen safe room that works, and the walk timing that avoids the worst of the night.',
    image: fireworksImg,
    imageAlt: 'Cream puppy resting in a covered playpen fireworks safe room in Singapore',
  },
  {
    title: 'Cavapoo vs Maltipoo: the Complete Breed Comparison',
    href: '/blog/cavapoo-vs-maltipoo/',
    date: '2026-07-07',
    tag: 'Breed comparison',
    excerpt:
      'They look alike; they live differently. The full table, plus the independence difference that decides most matches.',
    image: compareImg,
    imageAlt: 'Cavapoo puppy portrait, one half of the Cavapoo vs Maltipoo comparison',
  },
  {
    title: 'Low-Shedding, Low-Barking Dogs That HDB Allows',
    href: '/blog/hdb-dog-guide/',
    date: '2026-07-06',
    tag: 'Breed guides',
    excerpt:
      'The five approved breeds that fit flat life best, ranked by alone-time tolerance, noise, and grooming reality.',
    image: hdbImg,
    imageAlt: 'White Bichonpoo puppy, an HDB-approved low-shedding cross',
  },
  {
    title: '5 First-Time Puppy Owner Mistakes to Avoid',
    href: '/blog/first-time-mistakes/',
    date: '2026-07-06',
    tag: 'First-time owners',
    excerpt:
      'From real placements: choosing by photo, the 2am rescue, and the other classics, with the fixes attached.',
    image: mistakesImg,
    imageAlt: 'Cavapoo puppy settled in her playpen after an honest breed match',
  },
];

// The two reference hubs the blog feeds into. Posts are episodic; these are the
// structured versions of the same ground, and every post should be able to hand
// a reader off to one of them.
const hubs = [
  {
    eyebrow: 'Start here',
    title: 'The First-Time Owner Guide',
    href: '/first-time-owners/',
    body: 'Five decisions in the order that matters: breed by routine, the full first-year budget, verifying the seller, preparing the home, then week one. A guide behind each step.',
    cta: 'Open the checklist',
    image: ftoHubImg,
    imageAlt: 'First-time dog owner in Singapore working through a puppy checklist with a Cavapoo',
    links: [
      { label: 'Breed selector quiz', href: '/first-time-owners/breed-selector/' },
      { label: 'First-year budget planner', href: '/first-time-owners/budget-guide/' },
      { label: 'HDB-approved breeds', href: '/first-time-owners/hdb-breeds/' },
    ],
  },
  {
    eyebrow: 'Buyer protection',
    title: 'Learn: Licences, Health and Scams',
    href: '/learn/',
    body: 'The reference side of the site: how to check any pet shop against the AVS registry, what puppy vaccinations actually cover, and why smuggled puppies cost more than they save.',
    cta: 'Open the guides',
    image: learnHubImg,
    imageAlt: 'Buyer checking a Singapore pet shop licence on the AVS public registry before paying',
    links: [
      { label: 'Verify a pet shop licence', href: '/learn/verify-license/' },
      { label: 'Puppy health and vaccinations', href: '/learn/puppy-health/' },
      { label: 'Smuggled puppies in Singapore', href: '/learn/smuggled-puppies/' },
    ],
  },
];

const schemas = [
  localBusinessSchema(),
  personSchema(),
  webPageSchema({
    path: '/blog/',
    title,
    description,
    aboutName: 'Puppy guides and advice',
    datePublished: '2026-07-07',
    dateModified: new Date().toISOString().split('T')[0],
  }),
  itemListSchema(posts.map((p) => ({ name: p.title, url: p.href, description: p.excerpt }))),
];
---

<BaseLayout {title} {description} canonicalPath="/blog" ogImage="/assets/guides/og-first-time-owners.jpg">
  <section class="relative overflow-hidden bg-[var(--color-peach-100)] pb-12 pt-2">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <Blob class="absolute -top-16 -left-20 h-80 w-80 fill-[var(--color-mint-200)]/70 blob-drift-slow" />
      <Blob class="absolute top-10 right-[-6rem] h-72 w-72 fill-[var(--color-lilac-100)] blob-drift" />
      <PawPrint class="absolute left-[6%] top-[26%] h-10 w-10 text-[var(--color-mint-300)]/70 -rotate-12 blob-drift" />
      <PawPrint class="absolute right-[10%] top-[60%] h-8 w-8 text-[var(--color-coral-300)]/70 rotate-12 blob-drift-slow" />
    </div>
    <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8 pt-5">
      <Breadcrumb bare items={[{ label: 'Blog', href: '/blog/' }]} />
      <div class="mt-8 max-w-[70ch]">
        <p class="inline-flex items-center gap-2 rounded-full border-3 border-[var(--color-coral-400)] bg-white px-4 py-1.5 text-xs font-bold tracking-wide text-[var(--color-coral-600)] uppercase shadow-[0_4px_0_0_var(--color-coral-300)]" style="letter-spacing: 0.06em;">
          <PawPrint class="h-3.5 w-3.5" />
          The blog
        </p>
        <h1 class="mt-5 font-[family-name:var(--font-heading)] font-semibold leading-[1.05] text-[var(--color-cream-900)]" style="font-size: clamp(2.5rem, 5vw, 4rem);">
          Honest Advice, From the <span class="text-[var(--color-coral-500)]">Shop Floor</span>
        </h1>
        <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-[var(--color-cream-700)]">
          Guides written from real Singapore placements by Nelson and Kim: what actually goes wrong, what actually fits an HDB flat, and which breed actually suits your weekday. New posts land here first.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-5 sm:px-8 py-14">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, i) => (
        <article data-reveal style={`--i:${i}`} class="clay clay-hover flex h-full flex-col overflow-hidden bg-[var(--color-surface-card)]">
          <a href={post.href} class="block">
            <Image src={post.image} alt={post.imageAlt} format="webp" class="aspect-[16/10] w-full object-cover" widths={[480, 760]} sizes="(min-width: 1024px) 430px, 90vw" loading={i === 0 ? 'eager' : 'lazy'} />
          </a>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-2 text-xs">
              <span class="rounded-full bg-[var(--color-mint-100)] px-3 py-1 font-bold text-[var(--color-cream-700)]">{post.tag}</span>
              <time datetime={post.date} class="text-[var(--color-cream-500)]">{post.date}</time>
            </div>
            <h2 class="mt-3 font-[family-name:var(--font-heading)] text-xl font-semibold leading-snug text-[var(--color-cream-900)]">
              <a href={post.href} class="hover:text-[var(--color-coral-600)]">{post.title}</a>
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-cream-700)]">{post.excerpt}</p>
            <a href={post.href} class="mt-4 text-sm font-semibold text-[var(--color-accent-hover)] underline underline-offset-2 hover:text-[var(--color-coral-600)]">Read the post →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section aria-label="Guide hubs" class="bg-[var(--color-peach-100)] py-14">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
      <div class="max-w-[65ch]">
        <p class="text-sm font-bold uppercase text-[var(--color-coral-600)]" style="letter-spacing: 0.08em;">The reference shelf</p>
        <h2 class="mt-2 font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
          Prefer It Organised, Not Episodic?
        </h2>
        <p class="mt-2 text-base text-[var(--color-cream-600)]">
          Posts follow whatever a customer asked us that week. These two hubs cover the same ground in order, start to finish.
        </p>
      </div>

      <div class="mt-9 grid gap-6 md:grid-cols-2">
        {hubs.map((hub, i) => (
          <article data-reveal style={`--i:${i}`} class="clay clay-hover flex h-full flex-col overflow-hidden bg-[var(--color-surface-card)]">
            <a href={hub.href} class="block">
              <Image src={hub.image} alt={hub.imageAlt} format="webp" class="aspect-[16/9] w-full object-cover" widths={[480, 760]} sizes="(min-width: 768px) 660px, 90vw" loading="lazy" />
            </a>
            <div class="flex flex-1 flex-col p-7">
              <p class="text-xs font-bold uppercase text-[var(--color-coral-600)]" style="letter-spacing: 0.08em;">{hub.eyebrow}</p>
              <h3 class="mt-2 font-[family-name:var(--font-heading)] text-2xl font-semibold leading-snug text-[var(--color-cream-900)]">
                <a href={hub.href} class="hover:text-[var(--color-coral-600)]">{hub.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-cream-700)]">{hub.body}</p>
              <ul class="mt-4 flex-1 space-y-2">
                {hub.links.map((l) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-[var(--color-cream-700)]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="mt-0.5 shrink-0 text-[var(--color-coral-500)]" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <a href={l.href} class="underline underline-offset-2 hover:text-[var(--color-coral-600)]">{l.label}</a>
                  </li>
                ))}
              </ul>
              <a href={hub.href} class="clay-btn mt-6 inline-flex items-center justify-center gap-2 bg-[var(--color-accent)] px-6 py-3 text-sm font-bold text-white hover:bg-[var(--color-accent-hover)]">
                {hub.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PawTrail bg="bg-[var(--color-surface)]" colorClass="text-[var(--color-coral-300)]" />

  <BannerRibbon
    heading="Got a question a post hasn't answered?"
    body="Message us; real questions from real owners are where every post on this page started."
    ctaLabel="WhatsApp us"
    ctaMessage="Hi! I have a puppy question your blog hasn't covered yet:"
    variant="dark"
  />

  <section aria-label="Keep exploring" class="mx-auto max-w-[1400px] px-5 sm:px-8 py-8">
    <p class="text-sm leading-relaxed text-[var(--color-cream-600)]">Still comparing? See <a href="/" class="underline underline-offset-2 text-[var(--color-accent-hover)]">Curious Tails</a>.</p>
  </section>


  <FinalCta
    breed="Puppy"
    heading="Reading Done? Meet the Puppies"
    body="Can't make the trip to Balestier? WhatsApp us for current puppies and prices; honest answers either way."
    reserveMessage="Hi! I'd like to ask about your available puppies."
  />

  <Schema {schemas} />
</BaseLayout>
