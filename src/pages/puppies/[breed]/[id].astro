---
// Individual puppy page — one page per live puppy at /puppies/<breed>/<id>/.
// NEW FILE (added 2026-10-01). Driven by src/data/available-puppies.json and the
// shared design system: BaseLayout + clay tokens + shared components, so brand
// colours, the starter-kit marquee and the review slider all come from the real
// components. Layout uses plain full-width <section> bands (max-w-[1400px]) to
// match ListingGrid/marquee — NOT Section treatments, whose split/prose/cards
// grids squash a custom inner grid (that was the broken-layout bug, 2026-10-02).
// Business-level reviews stay on LocalBusiness (schema), never on the puppy Product.
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ListingGrid from '../../../components/ListingGrid.astro';
import StarterKitMarquee from '../../../components/StarterKitMarquee.astro';
import TestimonialWall from '../../../components/TestimonialWall.astro';
import ReviewSlider from '../../../components/ReviewSlider.astro';
import FinalCta from '../../../components/FinalCta.astro';
import Schema from '../../../components/Schema.astro';
import { site, whatsappLink } from '../../../data/site';
import { breedName as displayBreedName } from '../../../data/breed-names';
import { localBusinessSchema } from '../../../lib/schema';
import { photoFor, pupCard, pupTitle, pupPageSlug, type Pup, type BreedBucket } from '../../../lib/puppy-cards';
import data from '../../../data/available-puppies.json';

const breeds = data.breeds as Record<string, BreedBucket>;
const half = (g: Pup['gender']) => (g === 'Female' ? 'Girl' : g === 'Male' ? 'Boy' : 'Puppy');

export function getStaticPaths() {
  const breedsLocal = (data.breeds as Record<string, BreedBucket>);
  const paths: { params: { breed: string; id: string }; props: { pup: Pup; breed: string } }[] = [];
  for (const [breed, bucket] of Object.entries(breedsLocal)) {
    for (const pup of bucket.available ?? []) {
      if (!pup.image || !photoFor(pup.image)) continue; // only pups with a real photo
      paths.push({ params: { breed, id: pupPageSlug(pup) }, props: { pup, breed } });
    }
  }
  return paths;
}

const { pup, breed } = Astro.props as { pup: Pup; breed: string };
const breedNameDisp = displayBreedName(breed);
const title0 = pupTitle(pup, breedNameDisp);
const hero = photoFor(pup.image)!;
const canonicalPath = `/puppies/${breed}/${pupPageSlug(pup)}/`;
const priceStr = pup.price ? `$${pup.price.toLocaleString('en-SG')}` : 'Ask for price';
const genderNoun = half(pup.gender).toLowerCase();

const pageTitle = `${title0}: ${breedNameDisp} Puppy for Sale Singapore | Curious Tails`;
const description =
  `Meet ${title0}, a ${(pup.color ?? '').toLowerCase()} ${breedNameDisp} ${genderNoun}${pup.age ? `, ${pup.age}` : ''}. ` +
  `${priceStr} all-in${pup.hdbApproved ? ', HDB-approved' : ''}. Vaccinated, microchipped and vet-checked. WhatsApp Curious Tails, Balestier.`;

// Honest, attribute-derived intro — no invented personality claims.
const TEMPERAMENT: Record<string, string> = {
  cavapoo: 'gentle, people-focused and easygoing',
  cockapoo: 'warm, sociable and great with children',
  'shih-tzu': 'calm, affectionate and well suited to apartment living',
};
const temperament = TEMPERAMENT[breed] ?? 'friendly and family-oriented';
const pronoun = pup.gender === 'Female' ? 'She' : pup.gender === 'Male' ? 'He' : 'This puppy';
const pronounLc = pup.gender === 'Female' ? 'she' : pup.gender === 'Male' ? 'he' : 'they';
const pronounObj = pup.gender === 'Female' ? 'her' : pup.gender === 'Male' ? 'him' : 'them';

const waMsg = whatsappLink(
  `Hi! I'd like more photos and the price for ${pup.name ?? `puppy #${pup.id}`}, the ${[
    pup.color?.toLowerCase(),
    pup.gender?.toLowerCase(),
  ].filter(Boolean).join(' ')} ${breedNameDisp} puppy (ID ${pup.id}).`,
);
const waBook = whatsappLink(`Hi! I'd like to book a viewing for ${pup.name ?? `puppy #${pup.id}`} (ID ${pup.id}) at Balestier.`);

const spec: { k: string; v: string }[] = [
  { k: 'Breed', v: pup.crossLabel ?? breedNameDisp },
  { k: 'Puppy ID', v: `#${pup.id}` },
  ...(pup.gender ? [{ k: 'Gender', v: pup.gender }] : []),
  ...(pup.color ? [{ k: 'Colour', v: pup.color }] : []),
  ...(pup.age ? [{ k: 'Age', v: pup.age }] : []),
  ...(pup.origin ? [{ k: 'Origin', v: pup.origin }] : []),
  ...(pup.hdbApproved ? [{ k: 'HDB approved', v: 'Yes' }] : []),
  { k: 'Price', v: `${priceStr} all-in` },
];

const included = [
  'Vaccinated', 'Dewormed', 'Microchipped', 'Vet health-checked',
  'AVS licensed', 'Vaccination & health records',
];

// Why Curious Tails — real, verifiable differentiators (config/business-context.md),
// no invented claims. Each icon is a self-closing inline path set below.
const whyChoose = [
  {
    icon: 'shield',
    title: 'AVS-licensed, done by the book',
    body: `We're a licensed Singapore pet shop (AVS licence AS24J00046, verifiable on the public registry). Your dog licence and paperwork are completed for you at purchase.`,
  },
  {
    icon: 'heart',
    title: 'Healthy puppies, vet-backed',
    body: `Every puppy is vaccinated, dewormed, microchipped and passes a vet health check before going home. If yours falls sick within the first 5 days, bring it back and we'll nurse it.`,
  },
  {
    icon: 'tag',
    title: 'One honest all-in price',
    body: `Vaccination, microchip and licensing are already in the price, with nothing added later. Our pricing typically runs $500 to $2,000 below the big-name shops.`,
  },
  {
    icon: 'gift',
    title: '$500+ starter kit, set up at home',
    body: `Over 30 essentials, from playpen and carrier to grooming, food and toys, delivered and set up in your home for free, so your puppy settles in from day one.`,
  },
  {
    icon: 'paw',
    title: 'A free training lesson included',
    body: `Your first dog-training lesson with an AVS-certified trainer comes with every puppy, to start good habits early and answer your first real-life questions.`,
  },
  {
    icon: 'chat',
    title: 'Real support after you take them home',
    body: `Meet your puppy in person at Balestier with no pressure to buy, then reach us on WhatsApp any time for care questions long after the handover.`,
  },
];

// Other available puppies across the shop (exclude this one), for the cross-sell grid.
const others = Object.entries(breeds).flatMap(([slug, b]) =>
  (b.available ?? [])
    .filter((p) => String(p.id) !== String(pup.id) && p.image && photoFor(p.image))
    .map((p) => pupCard(p, displayBreedName(slug), 'available', { breedLabel: true, breedSlug: slug })),
).slice(0, 8);

const heroAbs = new URL(hero.src, site.domain).toString();
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${title0}: ${breedNameDisp} Puppy`,
  image: heroAbs,
  description,
  category: `${breedNameDisp} puppy`,
  sku: String(pup.id),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'SGD',
    ...(pup.price ? { price: pup.price } : {}),
    availability: 'https://schema.org/InStock',
    url: new URL(canonicalPath, site.domain).toString(),
    seller: { '@id': `${site.domain}#business` },
  },
};
---
<BaseLayout title={pageTitle} description={description} canonicalPath={canonicalPath} ogImage={heroAbs}>
  <Schema schemas={[productLd, localBusinessSchema()]} />

  {/* HERO */}
  <section class="mx-auto max-w-[1400px] px-5 sm:px-8 pt-8 pb-14">
    <Breadcrumb
      items={[
        { label: 'Puppies', href: '/puppies/' },
        { label: breedNameDisp, href: `/puppies/${breed}/` },
        { label: title0, href: canonicalPath },
      ]}
      bare
    />
    <div class="mt-6 grid items-start gap-8 lg:grid-cols-2">
      <div class="clay overflow-hidden bg-[var(--color-surface-card)] p-3">
        <Image
          src={hero}
          alt={`${title0}, ${breedNameDisp} puppy available in Singapore`}
          widths={[480, 768, 1000]}
          sizes="(max-width:1023px) 92vw, 640px"
          class="aspect-[4/3] w-full rounded-[1.1rem] object-cover"
        />
      </div>
      <div class="lg:py-2">
        <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-coral-600)]">{breedNameDisp} · {pup.gender ?? 'Puppy'}</p>
        <h1 class="mt-2 font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.9rem, 4vw, 2.9rem);">{title0}</h1>
        <p class="mt-2 text-[var(--color-cream-600)]">Puppy ID #{pup.id}{pup.age ? ` · ${pup.age}` : ''}</p>

        <div class="mt-4 flex flex-wrap gap-2">
          {pup.hdbApproved && <span class="rounded-full bg-[var(--color-mint-100)] px-3 py-1.5 text-xs font-bold text-[var(--color-cream-900)]">✓ HDB Approved</span>}
          <span class="rounded-full bg-[var(--color-mint-100)] px-3 py-1.5 text-xs font-bold text-[var(--color-cream-900)]">✓ Vaccinated</span>
          <span class="rounded-full bg-[var(--color-mint-100)] px-3 py-1.5 text-xs font-bold text-[var(--color-cream-900)]">✓ Microchipped</span>
          <span class="rounded-full bg-[var(--color-peach-100)] px-3 py-1.5 text-xs font-bold text-[var(--color-cream-900)]">Vet health-checked</span>
        </div>

        <div class="mt-5 flex items-baseline gap-3 border-y-2 border-[var(--color-cream-200)] py-4">
          <span class="font-semibold text-[var(--color-coral-600)]" style="font-size: clamp(2rem, 5vw, 2.8rem);">{priceStr}</span>
          <span class="rounded-full bg-[var(--color-mint-100)] px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-[var(--color-cream-900)]">All-in price</span>
        </div>

        <div class="mt-5 flex flex-col gap-3">
          <a href={waMsg} data-wa-source={`pup:${pup.id}`} class="clay-btn clay-press inline-flex items-center justify-center gap-2 bg-[#25D366] px-6 py-4 text-base font-bold text-white transition-transform hover:bg-[#1ebe57]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
            <span class="lg:hidden">Enquire on WhatsApp</span>
            <span class="hidden lg:inline">WhatsApp Us 8220 6408</span>
          </a>
          <a href={pup.bookHref ?? waBook} target={pup.bookHref ? '_blank' : undefined} rel={pup.bookHref ? 'noopener' : undefined} class="clay-btn-outline clay-press inline-flex items-center justify-center gap-2 bg-white px-6 py-3.5 text-base font-bold text-[var(--color-coral-600)] transition-transform">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Book a viewing
          </a>
        </div>
        <p class="mt-4 text-sm text-[var(--color-cream-600)]">No hidden fees: vaccination, microchip &amp; licence are already in the price. Vet-checked before going home.</p>
      </div>
    </div>
  </section>

  {/* ABOUT + PROFILE (tint band) */}
  <section class="bg-[var(--color-peach-100)] py-16 sm:py-20">
    <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
      <div class="grid items-stretch gap-8 lg:grid-cols-[1.45fr_1fr]">

        {/* LEFT: about card */}
        <div class="clay flex flex-col bg-[var(--color-surface-card)] p-7 sm:p-9">
          <p class="text-sm font-bold uppercase tracking-widest text-[var(--color-coral-600)]">Meet {pup.name ?? 'this puppy'}</p>
          <h2 class="mt-2 font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.7rem, 3vw, 2.4rem);">About {pup.name ?? 'this puppy'}</h2>

          <div class="mt-5 space-y-4 text-[1.05rem] leading-relaxed text-[var(--color-cream-800)]">
            <p>
              <span class="font-semibold text-[var(--color-cream-900)]">{title0}</span> is {['a','e','i','o','u'].includes((pup.color ?? '')[0]?.toLowerCase()) ? 'an' : 'a'} {(pup.color ?? '').toLowerCase()} {breedNameDisp} {genderNoun}{pup.age ? `, around ${pup.age} old` : ''}, ready for a loving Singapore home.
              {` ${breedNameDisp}s are ${temperament}.`}
            </p>
            <p>
              {pronoun} is vaccinated, dewormed, microchipped and has passed a vet health check before going home.
              {pup.hdbApproved ? ` ${pronounLc.charAt(0).toUpperCase() + pronounLc.slice(1)} is HDB-approved, so ${pronounLc} transfers into a flat with no separate approval needed.` : ''}
              {' You are welcome to meet '}{pronounObj}{' at our Balestier shop before you decide, with no pressure to buy.'}
            </p>
          </div>

          <div class="mt-auto pt-8">
            <div class="rounded-[1.3rem] border-2 border-[var(--color-cream-200)] bg-[var(--color-peach-100)] p-6 sm:p-7">
              <h3 class="flex items-center gap-2.5 text-lg font-bold text-[var(--color-cream-900)]">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-surface-card)]">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--color-coral-500)" stroke="var(--color-coral-500)" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.3 4.3 12.6a4.6 4.6 0 0 1 0-6.5 4.6 4.6 0 0 1 6.5 0l1.2 1.2 1.2-1.2a4.6 4.6 0 0 1 6.5 0 4.6 4.6 0 0 1 0 6.5z"/></svg>
                </span>
                Health &amp; what's included
              </h3>
              <ul class="grid grid-cols-1 gap-x-6 gap-y-4 border-t-2 border-[var(--color-cream-200)] sm:grid-cols-2" style="list-style:none;margin-top:1.5rem;margin-bottom:0;padding:1.5rem 0 0;">
                {included.map((i) => (
                  <li class="flex items-center gap-3">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-mint-100)] text-sm font-black text-[var(--color-lilac-700)]">✓</span>
                    <span class="text-sm font-semibold text-[var(--color-cream-800)]">{i}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        {/* RIGHT: profile card */}
        <div class="clay flex flex-col bg-[var(--color-surface-card)] p-7">
          <h3 class="text-sm font-bold uppercase tracking-widest text-[var(--color-coral-600)]">This puppy's profile</h3>
          <dl class="mt-3 divide-y divide-[var(--color-cream-200)]">
            {spec.map((r) => (
              <div class="flex items-center justify-between gap-4 py-3.5">
                <dt class="text-xs font-bold uppercase tracking-wide text-[var(--color-cream-600)]">{r.k}</dt>
                <dd class="text-right font-semibold text-[var(--color-cream-900)]" style="font-variant-numeric: tabular-nums;">{r.v}</dd>
              </div>
            ))}
          </dl>
          <a href={waMsg} data-wa-source={`pup:${pup.id}`} class="clay-btn clay-press mt-auto inline-flex w-full items-center justify-center gap-2 bg-[#25D366] px-5 py-3.5 text-sm font-bold text-white transition-transform hover:bg-[#1ebe57]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
            Ask about {pup.name ?? 'this puppy'}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* WHY CHOOSE CURIOUS TAILS */}
  <section class="relative overflow-hidden bg-[var(--color-lilac-100)] py-16 sm:py-24">
    {/* soft decorative blobs */}
    <span class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-[var(--color-mint-100)] opacity-50 blur-2xl" aria-hidden="true"></span>
    <span class="pointer-events-none absolute -right-24 bottom-10 h-80 w-80 rounded-full bg-[var(--color-peach-200)] opacity-50 blur-2xl" aria-hidden="true"></span>

    <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8">
      <div class="mx-auto max-w-[56ch] text-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--color-surface-card)] px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[var(--color-coral-600)]">
          🐾 Why families pick us
        </span>
        <h2 class="mt-4 font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.9rem, 3.4vw, 2.7rem);">
          Why choose <span class="text-[var(--color-coral-500)]">Curious Tails</span>
        </h2>
        <p class="mx-auto mt-3 max-w-[52ch] text-base text-[var(--color-cream-700)]">
          Bringing {pup.name ?? 'a puppy'} home is a 15-year decision. Here is what you get when {pronounLc} comes from us: not just a healthy puppy, but a licensed shop that stands behind {pronounObj}.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {whyChoose.map((w, idx) => {
          const accents = [
            { chip: 'bg-[var(--color-coral-500)] text-white', ring: 'hover:border-[var(--color-coral-300)]' },
            { chip: 'bg-[var(--color-lilac-500)] text-white', ring: 'hover:border-[var(--color-lilac-300)]' },
            { chip: 'bg-[var(--color-mint-300)] text-[var(--color-cream-900)]', ring: 'hover:border-[var(--color-mint-300)]' },
            { chip: 'bg-[var(--color-coral-700)] text-white', ring: 'hover:border-[var(--color-coral-300)]' },
            { chip: 'bg-[var(--color-lilac-700)] text-white', ring: 'hover:border-[var(--color-lilac-300)]' },
            { chip: 'bg-[var(--color-peach-300)] text-[var(--color-cream-900)]', ring: 'hover:border-[var(--color-peach-300)]' },
          ];
          const a = accents[idx % accents.length];
          return (
            <div class={`group clay relative flex flex-col gap-4 overflow-hidden bg-[var(--color-surface-card)] p-7 transition-transform duration-200 hover:-translate-y-1.5 border-2 border-transparent ${a.ring}`}>
              <span class={`relative flex h-14 w-14 items-center justify-center rounded-2xl shadow-sm ${a.chip}`}>
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {w.icon === 'shield' && <path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5z"/>}
                  {w.icon === 'heart' && <path d="M12 20.3 4.3 12.6a4.6 4.6 0 0 1 6.5-6.5l1.2 1.2 1.2-1.2a4.6 4.6 0 0 1 6.5 6.5z" fill="currentColor" stroke="none"/>}
                  {w.icon === 'tag' && <><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h6.9a2 2 0 0 1 1.4.6l7.5 7.5a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.3" fill="currentColor"/></>}
                  {w.icon === 'gift' && <><rect x="3" y="8" width="18" height="13" rx="1.5"/><path d="M3 12h18M12 8v13M12 8S10.5 3 8 4.2 9 8 12 8zM12 8s1.5-5 4-3.8S15 8 12 8z"/></>}
                  {w.icon === 'paw' && <><circle cx="7" cy="9" r="1.6"/><circle cx="12" cy="7.5" r="1.6"/><circle cx="17" cy="9" r="1.6"/><path d="M12 12c-2.8 0-5 2-5 4.3C7 18 8.4 19 10 19h4c1.6 0 3-1 3-2.7C17 14 14.8 12 12 12z"/></>}
                  {w.icon === 'chat' && <path d="M21 12a8 8 0 0 1-11.5 7.2L3 21l1.8-6.5A8 8 0 1 1 21 12z"/>}
                </svg>
              </span>
              <h3 class="relative text-lg font-bold leading-snug text-[var(--color-cream-900)]">{w.title}</h3>
              <p class="relative text-[0.95rem] leading-relaxed text-[var(--color-cream-700)]">{w.body}</p>
            </div>
          );
        })}
      </div>

      {/* trust anchor */}
      <div class="mt-10 flex flex-col items-center justify-between gap-5 rounded-[1.5rem] bg-[var(--color-surface-card)] px-7 py-6 text-center sm:flex-row sm:text-left">
        <div>
          <p class="font-bold text-[var(--color-cream-900)]">Licensed Singapore pet shop, not a backyard seller.</p>
          <p class="mt-1 text-sm text-[var(--color-cream-600)]">AVS pet shop licence AS24J00046 · 2 Balestier Road · Meet {pup.name ?? 'the puppy'} before you decide.</p>
        </div>
        <a href={waMsg} data-wa-source={`pup:${pup.id}`} class="clay-btn clay-press inline-flex shrink-0 items-center justify-center gap-2 bg-[#25D366] px-6 py-3.5 text-sm font-bold text-white transition-transform hover:bg-[#1ebe57]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2z"/></svg>
          Chat with us on WhatsApp
        </a>
      </div>
    </div>
  </section>

  {/* HAPPY FAMILIES (shared component) */}
  <TestimonialWall />

  {/* FREE GIFT MARQUEE (shared component) */}
  <StarterKitMarquee />

  {/* GOOGLE REVIEWS (shared component, per-breed) */}
  <ReviewSlider slug={breed} heading="What Curious Tails owners say" />

  {/* OTHER PUPPIES AVAILABLE */}
  {others.length > 0 && (
    <ListingGrid
      heading="Other Puppies Available Now"
      headingAccent="Available Now"
      subhead="More real puppies in our care right now, every price all-in. Tap any pup to see its own page."
      items={others}
    />
  )}

  <FinalCta breed={breedNameDisp} reserveMessage={`Hi! I'd like to reserve ${pup.name ?? `puppy #${pup.id}`} (ID ${pup.id}).`} browseHref="/available-puppies/" browseLabel="Browse all available puppies" />
</BaseLayout>
