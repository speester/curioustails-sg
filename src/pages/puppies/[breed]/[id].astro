---
// Individual puppy route: /puppies/<breed>/<id-slug>/. Since K-130 every kind of
// puppy page renders ONE template, src/components/puppy-page/PuppyPage.astro
// (the K-124 Biscuit page extracted into components):
//   * available (Balestier shop)  -> variant "av", from available-puppies.json
//   * placed (found a home)       -> variant "pl", from placed-archive.json
//   * imported reservation        -> variant "imp", from imported-puppies.json
//     (path /puppies/<breed>/imp-<10 hex>/, noindex,follow, out of the sitemap,
//     owner decision D11)
//
// Publish rule (src/lib/puppy-publish.mjs, owner rulings 2026-11-14): only
// Balestier puppies get a page; every Balestier puppy gets one, and a puppy
// missing its breed page, photo or price gets a THIN page (noindex,follow, no
// Offer, honest placeholders). A Balestier puppy whose sheet breed has no breed
// page lives at /puppies/other/<id-slug>/. URLs, pupPageSlug and the redirects
// are unchanged for every puppy that already had a page.
import PuppyPage from '../../../components/puppy-page/PuppyPage.astro';
import { photoFor } from '../../../lib/puppy-cards';
import { placedPups, type PlacedPup } from '../../../lib/loving-homes';
import { importedPups, type ImportedPup } from '../../../lib/imported-puppies';
import { fromLocal, fromPlaced, fromImported, pupPageSlug } from '../../../lib/puppy-page';
import { localGate, localRows, fixtureRows, NO_BREED_SEGMENT } from '../../../lib/puppy-publish.mjs';

export function getStaticPaths() {
  const fx = fixtureRows();
  // In-scope local rows (Balestier, with an id). Out-of-scope rows get nothing.
  const local = (localRows() as { breed: string | null; pup: any }[]).filter(
    ({ breed, pup }) => localGate(pup, { breed, hasPhoto: Boolean(photoFor(pup.image)) }).inScope,
  );
  const paths: { params: { breed: string; id: string }; props: { kind: 'local' | 'placed' | 'imported'; row: any; breed: string | null; rows: typeof local } }[] = [];
  const seen = new Set<string>();
  const add = (breed: string, id: string, props: (typeof paths)[number]['props']) => {
    const key = `${breed}/${id}`;
    if (seen.has(key)) return;
    seen.add(key);
    paths.push({ params: { breed, id }, props });
  };
  for (const r of local) add(r.breed ?? NO_BREED_SEGMENT, pupPageSlug(r.pup), { kind: 'local', row: r.pup, breed: r.breed, rows: local });
  // Placed puppies (sold evidence, inside retention, real photo) keep their URL.
  const placed = [...placedPups(), ...(fx.placed as PlacedPup[]).filter((p) => p.status === 'placed' && photoFor(p.image))];
  for (const p of placed) add(p.breed, pupPageSlug(p as any), { kind: 'placed', row: p, breed: p.breed, rows: local });
  // Imported reservations, from the public feed only.
  const imported = [...importedPups(), ...(fx.imported as ImportedPup[])];
  for (const p of imported) {
    if (!p.breed || !p.id || !p.id.startsWith('imp-')) continue;
    add(p.breed, p.id, { kind: 'imported', row: p, breed: p.breed, rows: local });
  }
  return paths;
}

const { kind, row, breed, rows } = Astro.props;
const p = kind === 'imported' ? fromImported(row) : kind === 'placed' ? fromPlaced(row) : fromLocal(row, breed);
---
<PuppyPage p={p} rows={rows} />
