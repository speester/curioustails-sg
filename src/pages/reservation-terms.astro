---
// K-136: the written reservation terms for imported puppies, linked from every
// imported listing (Ireland and the Australian reservations, clause A1).
//
// The wording is the 2026-11-13 legal redline, clean text, Parts A and B only,
// copied word for word into src/data/reservation-terms.json by
// reports/k136-tools/extract-terms.mjs. It is STILL WITH COUNSEL, so this page
// says so at the top, is noindex (and out of the sitemap), and marks every
// square-bracketed open point. When counsel signs: re-run the extractor on the
// signed text, drop the banner and the noindex, and change the link label in
// src/data/buying-terms.ts. Part C (takedown) is not published here: C1 is a
// separate proposed page and C2 is an internal procedure.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import terms from '../data/reservation-terms.json';
import { RESERVATION_TERMS_PATH } from '../data/buying-terms';

const title = 'Reservation Terms for Imported Puppies (Draft) | Curious Tails';
const description =
  'Draft reservation terms for imported puppies at Curious Tails: deposit, balance, cancellation, refunds and arrival delays. Under legal review, not yet final.';

// "[...]" in the redline is an open point with counsel: split it out so the page can mark it.
const pieces = (para: string) =>
  para.split(/(\[[^\]]+\])/g).filter(Boolean).map((t) => ({ open: /^\[.*\]$/.test(t), text: t }));
---

<BaseLayout {title} {description} canonicalPath={RESERVATION_TERMS_PATH} noindex robots="noindex, follow">
  <section class="hero relative mx-auto max-w-[820px] px-5 sm:px-8 pt-6 pb-16" data-hero-archetype="centered-statement" data-section-pattern="prose" data-terms-status={terms.status}>
    <Breadcrumb items={[{ label: 'Reservation terms', href: RESERVATION_TERMS_PATH }]} bare />

    <h1 class="mt-6 font-[family-name:var(--font-heading)] font-semibold leading-tight text-[var(--color-cream-900)]" style="font-size: clamp(2.25rem, 4vw, 3.25rem);">
      Reservation terms for imported puppies
    </h1>

    <div role="note" data-terms-draft class="mt-6 rounded-[1rem] border-2 border-dashed border-[var(--color-coral-600)] bg-[var(--color-peach-100)] px-5 py-4 text-base leading-relaxed text-[var(--color-cream-900)]">
      <strong>Draft, under legal review.</strong> This is the wording we have sent to our lawyer. It is not final and may change.
      The terms that apply to your reservation are the ones in your written reservation confirmation. Points marked
      <mark class="rounded bg-[var(--color-lilac-100)] px-1">open point</mark> are still being decided.
    </div>

    {terms.parts.map((part) => (
      <div class="mt-12">
        <h2 class="font-[family-name:var(--font-heading)] text-2xl font-semibold text-[var(--color-cream-900)]">{part.title}</h2>
        {part.clauses.map((clause) => (
          <div class="mt-8">
            <h3 class="font-[family-name:var(--font-heading)] text-lg font-semibold text-[var(--color-cream-900)]">{clause.heading}</h3>
            {clause.paras.map((para) => (
              <p class="mt-3 text-base leading-relaxed text-[var(--color-cream-700)]">
                {pieces(para).map((t) => (t.open ? <mark class="rounded bg-[var(--color-lilac-100)] px-1" title="Open point with our lawyer">open point: {t.text.slice(1, -1)}</mark> : t.text))}
              </p>
            ))}
          </div>
        ))}
      </div>
    ))}
  </section>
</BaseLayout>
