---
// K-136: the written reservation terms for imported puppies, linked from every
// imported listing and from the reserve section on breed pages (Ireland and the
// Australian reservations, clause A1).
//
// Final, owner-approved terms (2026-11-22). The owners chose not to use counsel,
// so the draft banner, the noindex and the sitemap exclusion are gone. The
// wording lives in src/data/reservation-terms.json and is edited there directly;
// bump its version and effective date whenever the wording changes, because the
// written reservation confirmation names the version that applies. Part C of the
// old redline (takedown) is not published here: C1 is a separate proposed page
// and C2 is an internal procedure.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import terms from '../data/reservation-terms.json';
import { RESERVATION_TERMS_PATH } from '../data/buying-terms';

const title = 'Reservation Terms for Imported Puppies | Curious Tails';
const description =
  "Curious Tails reservation terms for imported puppies: 50% deposit, cancellations, full refunds if the import can't go ahead, and arrival delays.";
---

<BaseLayout {title} {description} canonicalPath={RESERVATION_TERMS_PATH}>
  <section class="hero relative mx-auto max-w-[820px] px-5 sm:px-8 pt-6 pb-16" data-hero-archetype="centered-statement" data-section-pattern="prose" data-terms-status={terms.status}>
    <Breadcrumb items={[{ label: 'Reservation terms', href: RESERVATION_TERMS_PATH }]} bare />

    <h1 class="mt-6 font-[family-name:var(--font-heading)] font-semibold leading-tight text-[var(--color-cream-900)]" style="font-size: clamp(2.25rem, 4vw, 3.25rem);">
      Reservation terms for imported puppies
    </h1>

    <p data-terms-version class="mt-4 text-sm font-semibold text-[var(--color-cream-700)]">
      Version {terms.version} · Effective {terms.effective}
    </p>
    <p class="mt-4 text-base leading-relaxed text-[var(--color-cream-700)]">
      These are the terms for reserving a puppy we import for you. Your written reservation confirmation names the version that applies to your reservation. Questions about any clause? WhatsApp us before you pay anything.
    </p>

    {terms.parts.map((part) => (
      <div class="mt-12">
        <h2 class="font-[family-name:var(--font-heading)] text-2xl font-semibold text-[var(--color-cream-900)]">{part.title}</h2>
        {part.clauses.map((clause) => (
          <div class="mt-8">
            <h3 class="font-[family-name:var(--font-heading)] text-lg font-semibold text-[var(--color-cream-900)]">{clause.heading}</h3>
            {clause.paras.map((para) => (
              <p class="mt-3 text-base leading-relaxed text-[var(--color-cream-700)]">{para}</p>
            ))}
          </div>
        ))}
      </div>
    ))}
  </section>
</BaseLayout>
