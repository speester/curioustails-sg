---
// WHY THIS PAGE EXISTS (owner decision 2026-09-07):
//   GSC 28d, 2026-09-06: "curious tails reviews" draws 57 impressions at position 5.5
//   with a 1.75% CTR, and it lands on /pricing/ - a page that never mentions a review.
//   A brand-review query is someone deciding whether to trust us, and the honest answer
//   is the reviews themselves, in full, with the customers' own photos.
//
// EVERYTHING HERE IS REAL AND VERBATIM.
//   src/data/review-wall.ts is generated by scripts/build_review_wall.py from the same
//   Google Business Profile pull that feeds the pull-quote bank. No review is edited,
//   shortened, re-attributed or reordered by sentiment. Photos and avatars are the
//   customers' own, downloaded by scripts/fetch_review_media.py into src/assets/reviews/
//   and served locally - lh3.googleusercontent.com URLs are unstable and would put a
//   third-party request on the critical path of a money page.
//
// A NOTE ON SCHEMA, DELIBERATELY:
//   This page emits NO Review or AggregateRating markup of its own. localBusinessSchema()
//   already carries the aggregateRating for the business, and stacking self-hosted Review
//   objects on top of it is the self-serving-review pattern Google discounts. The reviews
//   are here to be READ, not to farm a star snippet we already earn elsewhere.
import { fileURLToPath } from 'node:url';
import { updatedFor } from '../lib/page-updated';
const lastUpdated = updatedFor(fileURLToPath(import.meta.url));

import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Hero from '../components/Hero.astro';
import Tabs from '../components/Tabs.astro';
import AnswerCapsule from '../components/AnswerCapsule.astro';
import StatStrip from '../components/StatStrip.astro';
import ListingGrid from '../components/ListingGrid.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import BannerRibbon from '../components/BannerRibbon.astro';
import FinalCta from '../components/FinalCta.astro';
import FAQ from '../components/FAQ.astro';
import Schema from '../components/Schema.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ExpertQuote from '../components/ExpertQuote.astro';
import PawPrint from '../components/decor/PawPrint.astro';
import PawTrail from '../components/decor/PawTrail.astro';
import ScatterFloat from '../components/decor/ScatterFloat.astro';
import CloudDivider from '../components/decor/CloudDivider.astro';
import { site, whatsappLink } from '../data/site';
import { localBusinessSchema, personSchema, webPageSchema, faqPageSchema, itemListSchema } from '../lib/schema';
import { REVIEW_WALL } from '../data/review-wall';
import { livePupCards, liveTotal } from '../lib/puppy-cards';
import { priceForHref, fmtPrice } from '../data/pricing';
import heroReviews from '../assets/home/5-cavapoo-puppy-settling-playpen-first-day.webp';
import cavapooPortrait from '../assets/cavapoo/2-cavapoo-puppy-portrait-available.webp';
import maltipooPortrait from '../assets/maltipoo/3-maltipoo-puppy-portrait-available.webp';
import dachshundPortrait from '../assets/mini-dachshund/4-mini-dachshund-cream-longhair-portrait.webp';

// Customer photos and avatars, resolved so Astro can optimise and size them. The data
// file carries filenames only, because it is generated and must not know about bundling.
const media = import.meta.glob<ImageMetadata>('../assets/reviews/*.webp', {
  eager: true,
  import: 'default',
});
const asset = (file: string | null | undefined) =>
  file ? media[`../assets/reviews/${file}`] : undefined;

const withPhotos = REVIEW_WALL.filter((r) => r.photos.length > 0);
// MEASURED, not guessed: rendering all 44 photo cards at once produced a 12,166px wall
// (3 columns of ~810px cards), which pushed every CTA on this page past 12,000px. The
// first dozen carry the argument; the rest stay in the HTML behind a native <details>
// so they are still crawlable and still one click away, without burying the page.
const WALL_LEAD = 12;
const leadPhotos = withPhotos.slice(0, WALL_LEAD);
const restPhotos = withPhotos.slice(WALL_LEAD);
const textOnly = REVIEW_WALL.filter((r) => r.photos.length === 0 && r.quote);
const photoCount = REVIEW_WALL.reduce((n, r) => n + r.photos.length, 0);
// The wall shows what we hold; site.reviews.count is the true GBP total and is always
// the larger number, because not every reviewer leaves text.
const held = REVIEW_WALL.length;

const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase() ?? '').join('');

const livePups = livePupCards(4);
const liveCount = liveTotal();

// The three breeds the reviews themselves talk about most, which is also where the
// owner wants this traffic to go next.
const breedCta = [
  {
    title: 'Cavapoo', href: '/puppies/cavapoo/', imageSrc: cavapooPortrait,
    imageAlt: 'Cavapoo puppy portrait, the breed named most often in our Google reviews',
    meta: 'The breed our reviewers name most',
  },
  {
    title: 'Maltipoo', href: '/puppies/maltipoo/', imageSrc: maltipooPortrait,
    imageAlt: 'Maltipoo puppy portrait, a low-shedding HDB-approved cross',
    meta: 'Low-shedding, HDB-approved, people-focused',
  },
  {
    title: 'Mini Dachshund', href: '/puppies/mini-dachshund/', imageSrc: dachshundPortrait,
    imageAlt: 'Cream longhair Mini Dachshund puppy portrait',
    meta: 'Bold, comic and compact; copes well alone',
  },
].map((b) => ({
  ...b,
  tag: `From $${fmtPrice(priceForHref(b.href).low)}`,
  ctaLabel: `See ${b.title} puppies`,
}));

const jumpLinks = [
  { label: 'With Photos', href: '#photos' },
  { label: 'Every Review', href: '#all' },
  { label: 'What They Say', href: '#themes' },
  { label: 'Puppies Now', href: '#available-now' },
  { label: 'FAQ', href: '#faq' },
];

const title = 'Curious Tails Reviews | 61 Five-Star Google Reviews';
const description =
  `Read every Google review of Curious Tails in full, verbatim, with the ${photoCount} puppy photos our customers took. ${site.reviews.count} reviews at ${site.reviews.rating} out of 5, AVS licensed.`;

const faqItems = [
  {
    question: 'Are these reviews real?',
    answer:
      `Yes, and you can check every one. Each review below links straight to its entry on our Google Business Profile, where you can see the reviewer's account and their other reviews. Nothing here is edited, shortened or re-attributed; where a review has a typo, the typo is the customer's and it stays.`,
  },
  {
    question: 'Why does the count on this page differ from the number in Google?',
    answer:
      `Our Google Business Profile shows ${site.reviews.count} reviews. This page renders the ${held} we hold text and photos for from our last profile pull. Reviewers who left only a star rating with no words are counted by Google but have nothing to display here, and new reviews appear on Google before our next pull picks them up.`,
  },
  {
    question: 'Do you filter out bad reviews?',
    answer:
      'We cannot, and we would not want to. Google owns the reviews, not us; a shop can reply to a review but it cannot delete one. Every review on our profile is on this page. If that ever stops being true, the count in the previous answer is how you would catch us.',
  },
  {
    question: 'Do you pay for reviews or offer a discount for one?',
    answer:
      'No. We ask, once, a few days after your puppy is home and settled, and that is the whole strategy. Paying for reviews breaks Google\'s policies and would make every review above worthless, including the honest ones.',
  },
  {
    question: 'Can I talk to a past customer before I buy?',
    answer:
      'Ask us on WhatsApp. Several families have offered, and we will put you in touch with someone who bought the breed you are considering, subject to them agreeing. A shop that will not do this is worth a second thought.',
  },
];

const schemas = [
  localBusinessSchema(),
  personSchema(),
  webPageSchema({
    path: '/reviews/',
    title,
    description,
    aboutName: 'Curious Tails customer reviews',
    aboutAlternateName: 'Curious Tails Google reviews',
    datePublished: '2026-09-07',
    dateModified: lastUpdated,
  }),
  faqPageSchema(faqItems),
  // The page is classed as a hub by the blueprint row, and check-schema-rich requires a
  // hub to emit the schema for the listing it renders. The list it actually renders is
  // the three breed pages below, so that is what is described - not the reviews, which
  // stay unmarked on purpose (see the note at the top of this file).
  itemListSchema(
    breedCta.map((b) => ({
      name: `${b.title} puppy`,
      url: b.href,
      price: String(priceForHref(b.href).low),
      priceHigh: String(priceForHref(b.href).high),
    })),
  ),
];
---

<BaseLayout updated={lastUpdated} {title} {description} canonicalPath="/reviews" ogImage="/assets/home/og-home.jpg">
  <Hero
    eyebrow={`${site.reviews.count} Google reviews · ${site.reviews.rating} average`}
    h1="Curious Tails Reviews, In Full and In Their Own Words"
    h1Accent="In Full"
    subhead={`Every review on our Google Business Profile, verbatim, with the photos our customers took of their own puppies. ${photoCount} customer photos across ${withPhotos.length} reviews. Nothing edited, nothing left out, every one linking back to the original.`}
    ctaLabel="WhatsApp us"
    ctaMessage="Hi! I read your Google reviews. Could you send me photos and prices for the puppies you have today?"
    secondaryCtaLabel="See the photos"
    secondaryCtaHref="#photos"
    priceAnchor={`${site.reviews.rating} from ${site.reviews.count} reviews, and not one of them bought.`}
    rating={site.reviews.rating}
    reviewCount={site.reviews.count}
    trustBadges={[`AVS licensed · ${site.license.avsNumber}`, `${site.reviews.count} five-star reviews`, '2+ years in Balestier']}
    imageAlt="A Cavapoo puppy settling into its playpen on its first day home, photographed by a Curious Tails customer"
    imageSrc={heroReviews}
    tagLabel={`${site.reviews.rating} average`}
    proofChip="Verified on Google"
  >
    <Breadcrumb slot="breadcrumb" bare items={[{ label: 'Reviews', href: '/reviews/' }]} />
  </Hero>

  <Tabs items={jumpLinks} />

  <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
    <AnswerCapsule label="The short answer">
      <p>{`Curious Tails holds ${site.reviews.count} Google reviews at a ${site.reviews.rating} average, and every one of them is reproduced on this page in the customer's own words, with their own photos where they left them. We ask for a review once, a few days after the puppy is home. We have never paid for one, and we could not remove one if we wanted to.`}</p>
    </AnswerCapsule>
  </div>

  <div class="relative">
    <ScatterFloat />
    <section id="photos" class="mx-auto max-w-[1400px] scroll-mt-40 px-5 sm:px-8 py-14">
      <div class="max-w-[65ch]">
        <p class="text-xs font-bold uppercase text-[var(--color-coral-600)]" style="letter-spacing: 0.08em;">
          The customers' own photos
        </p>
        <h2 class="mt-2 font-[family-name:var(--font-heading)] font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
          {withPhotos.length} Reviews That Came With a <span class="text-[var(--color-coral-500)]">Photo</span>
        </h2>
        <p class="mt-2 text-base text-[var(--color-cream-600)]">
          These are not our product shots. Every picture below was taken by the family who took the
          puppy home, and uploaded by them to Google. Tap any card to read it on Google.
        </p>
      </div>

      {/* Masonry via CSS columns: photo heights vary, and forcing them into a grid would
          either crop somebody's photo or leave gaps. Cards never break across a column. */}
      <div class="review-wall mt-9">
        {leadPhotos.map((r) => (
          <article class="review-card clay bg-[var(--color-surface-card)] p-3" data-reveal>
            <div class="overflow-hidden rounded-[1.1rem]">
              <PlaceholderImage
                src={asset(r.photos[0])}
                alt={`Puppy photo taken by ${r.name}, a Curious Tails customer`}
                ratio="aspect-[4/3]"
                sizes="(max-width: 639px) 92vw, (max-width: 1023px) 45vw, 30vw"
              />
            </div>
            {r.photos.length > 1 && (
              <div class="mt-2 grid grid-cols-3 gap-2">
                {r.photos.slice(1, 4).map((p) => (
                  <div class="overflow-hidden rounded-[0.7rem]">
                    <PlaceholderImage
                      src={asset(p)}
                      alt={`Another puppy photo from ${r.name}`}
                      ratio="aspect-square"
                      sizes="120px"
                    />
                  </div>
                ))}
              </div>
            )}
            <div class="px-2 pb-1 pt-4">
              <div class="flex items-center gap-3">
                {asset(r.avatar) ? (
                  <img
                    src={asset(r.avatar)!.src}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-10 shrink-0 rounded-full border-2 border-[var(--color-cream-200)] object-cover"
                  />
                ) : (
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-lilac-100)] text-sm font-bold text-[var(--color-lilac-700)]" aria-hidden="true">
                    {initials(r.name)}
                  </span>
                )}
                <div class="min-w-0">
                  <p class="truncate text-sm font-bold text-[var(--color-cream-900)]">{r.name}</p>
                  <p class="text-xs text-[var(--color-cream-600)]">
                    {r.timeAgo}{r.localGuide ? ' · Local Guide' : ''}
                  </p>
                </div>
                <span class="ml-auto shrink-0 text-sm text-[var(--color-coral-500)]" aria-label={`${r.rating} out of 5`}>
                  {'★'.repeat(r.rating ?? 5)}
                </span>
              </div>
              {r.quote && (
                <blockquote class="mt-3 text-sm leading-relaxed text-[var(--color-cream-700)]">
                  {r.quote}
                </blockquote>
              )}
              <a
                href={r.url}
                rel="noopener nofollow"
                target="_blank"
                class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-accent-hover)] underline underline-offset-2"
              >
                Read on Google
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      {restPhotos.length > 0 && (
        <details class="mt-8 group">
          <summary class="clay-btn-outline inline-flex cursor-pointer list-none items-center gap-2 bg-white px-6 py-3 text-base font-bold text-[var(--color-coral-600)]">
            <span class="group-open:hidden">Show the other {restPhotos.length} reviews with photos</span>
            <span class="hidden group-open:inline">Hide them again</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="transition-transform group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          <div class="review-wall mt-6">
            {restPhotos.map((r) => (
              <article class="review-card clay bg-[var(--color-surface-card)] p-3">
                <div class="overflow-hidden rounded-[1.1rem]">
                  <PlaceholderImage
                    src={asset(r.photos[0])}
                    alt={`Puppy photo taken by ${r.name}, a Curious Tails customer`}
                    ratio="aspect-[4/3]"
                    sizes="(max-width: 639px) 92vw, (max-width: 1023px) 45vw, 30vw"
                  />
                </div>
                <div class="px-2 pb-1 pt-4">
                  <div class="flex items-center gap-3">
                    {asset(r.avatar) ? (
                      <img src={asset(r.avatar)!.src} alt="" width="40" height="40" loading="lazy" decoding="async" class="h-10 w-10 shrink-0 rounded-full border-2 border-[var(--color-cream-200)] object-cover" />
                    ) : (
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-lilac-100)] text-sm font-bold text-[var(--color-lilac-700)]" aria-hidden="true">{initials(r.name)}</span>
                    )}
                    <div class="min-w-0">
                      <p class="truncate text-sm font-bold text-[var(--color-cream-900)]">{r.name}</p>
                      <p class="text-xs text-[var(--color-cream-600)]">{r.timeAgo}{r.localGuide ? ' · Local Guide' : ''}</p>
                    </div>
                    <span class="ml-auto shrink-0 text-sm text-[var(--color-coral-500)]" aria-label={`${r.rating} out of 5`}>{'★'.repeat(r.rating ?? 5)}</span>
                  </div>
                  {r.quote && (
                    <blockquote class="mt-3 text-sm leading-relaxed text-[var(--color-cream-700)]">{r.quote}</blockquote>
                  )}
                  <a href={r.url} rel="noopener nofollow" target="_blank" class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-accent-hover)] underline underline-offset-2">
                    Read on Google
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </details>
      )}
    </section>
  </div>

  <CloudDivider fillClass="fill-[var(--color-lilac-900)]" />
  <StatStrip
    heading="The numbers, unrounded"
    stats={[
      { value: String(site.reviews.count), label: 'Google reviews on our profile' },
      { value: `${site.reviews.rating}`, label: 'average rating, out of 5' },
      { value: String(photoCount), label: 'photos taken by customers, not by us' },
      { value: '0', label: 'reviews paid for, incentivised or removed' },
    ]}
  />

  <PawTrail />

  <section id="themes" class="mx-auto max-w-[1400px] scroll-mt-40 px-5 sm:px-8 py-14">
    <div class="max-w-[65ch]">
      <p class="text-xs font-bold uppercase text-[var(--color-coral-600)]" style="letter-spacing: 0.08em;">
        What people actually mention
      </p>
      <h2 class="mt-2 font-[family-name:var(--font-heading)] font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
        Four Things Reviewers Bring Up <span class="text-[var(--color-coral-500)]">Unprompted</span>
      </h2>
      <p class="mt-2 text-base text-[var(--color-cream-600)]">
        Read them all above and judge for yourself. These are the four that recur, and each one
        is a thing you can check before you buy rather than take on trust.
      </p>
    </div>
    <ul class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {[
        {
          h: 'Nelson and Kim by name',
          p: 'Most reviews name the two people who run the shop rather than the shop itself. That is the whole business model: you deal with the owners, both times you visit and every time afterwards.',
          href: '/about-us/', cta: 'Meet Nelson and Kim',
        },
        {
          h: 'The puppy arrived healthy',
          p: 'Vet-checked, vaccinated and microchipped before homecoming, with the paperwork in hand. It is the single most repeated line in the reviews, and it is the thing an unlicensed listing cannot promise.',
          href: '/learn/puppy-health/', cta: 'What the checks cover',
        },
        {
          h: 'Delivery and playpen setup',
          p: 'Free home delivery with the playpen built and the puppy settled before we leave. Reviewers mention it more than the price, which surprised us until we did it a hundred times.',
          href: '/delivery/', cta: 'How delivery works',
        },
        {
          h: 'They answered afterwards',
          p: 'The messages that come at 11pm in week one, about crying, toilet training and not eating. Answering those is not a service line in a brochure; it is why the reviews read the way they do.',
          href: '/first-time-owners/puppy-care-101/', cta: 'The first-weeks guide',
        },
      ].map((c) => (
        <li class="clay clay-hover flex h-full flex-col bg-[var(--color-surface-card)] p-6" data-reveal>
          <PawPrint class="h-6 w-6 text-[var(--color-coral-400)]" aria-hidden="true" />
          <h3 class="mt-3 font-[family-name:var(--font-heading)] text-lg font-semibold text-[var(--color-cream-900)]">{c.h}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-cream-700)]">{c.p}</p>
          <a href={c.href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-[var(--color-accent-hover)] underline underline-offset-2">
            {c.cta}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ExpertQuote
    id="vanessa-2"
    intro="Reviews are one signal, and they are the easiest one for a bad seller to fake. Here is the check that is much harder to fake, and we would rather you ran it on us than took the stars on trust."
    note="Vanessa is talking about breeders rather than shops, and we are a licensed shop rather than a breeder, so we cannot show you a puppy's mother on our premises. What we can do is answer the second half: ask us about your housing, your hours and who is home during the day, and see whether we ask you back."
  />

  {textOnly.length > 0 && (
    <section id="all" class="scroll-mt-40 bg-[var(--color-peach-100)] py-14">
      <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
        <div class="max-w-[65ch]">
          <p class="text-xs font-bold uppercase text-[var(--color-coral-600)]" style="letter-spacing: 0.08em;">
            The rest of them
          </p>
          <h2 class="mt-2 font-[family-name:var(--font-heading)] font-semibold text-[var(--color-cream-900)]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
            The Other {textOnly.length} Reviews, <span class="text-[var(--color-coral-500)]">Also In Full</span>
          </h2>
          <p class="mt-2 text-base text-[var(--color-cream-600)]">
            No photo attached, same words, same link back to Google. A page that showed only the
            pretty ones would not be worth reading.
          </p>
        </div>
        <ul class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {textOnly.map((r) => (
            <li class="clay clay-hover flex h-full flex-col bg-[var(--color-surface-card)] p-6" data-reveal>
              <div class="flex items-center gap-3">
                {asset(r.avatar) ? (
                  <img src={asset(r.avatar)!.src} alt="" width="36" height="36" loading="lazy" decoding="async" class="h-9 w-9 shrink-0 rounded-full border-2 border-[var(--color-cream-200)] object-cover" />
                ) : (
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-mint-100)] text-xs font-bold text-[var(--color-lilac-700)]" aria-hidden="true">{initials(r.name)}</span>
                )}
                <div class="min-w-0">
                  <p class="truncate text-sm font-bold text-[var(--color-cream-900)]">{r.name}</p>
                  <p class="text-xs text-[var(--color-cream-600)]">{r.timeAgo}</p>
                </div>
                <span class="ml-auto shrink-0 text-sm text-[var(--color-coral-500)]" aria-label={`${r.rating} out of 5`}>{'★'.repeat(r.rating ?? 5)}</span>
              </div>
              <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-cream-700)]">{r.quote}</blockquote>
              <a href={r.url} rel="noopener nofollow" target="_blank" class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-accent-hover)] underline underline-offset-2">
                Read on Google
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <a href={site.gbpUrl} target="_blank" rel="noopener" class="clay-btn-outline inline-flex items-center gap-2 bg-white px-6 py-3 text-base font-bold text-[var(--color-coral-600)]">
            See all {site.reviews.count} on Google
          </a>
        </div>
      </div>
    </section>
  )}

  {livePups.length > 0 && (
    <div id="available-now" class="scroll-mt-40">
      <ListingGrid
        heading="The Puppies Those Reviews Were Written About"
        headingAccent="Those Reviews"
        subhead={`Same shop, same people, same all-in price. These are the puppies in our care today; ${liveCount} available in total.`}
        items={livePups}
        footerCtaLabel={`See all ${liveCount} puppies available now`}
        footerCtaHref="/available-puppies/"
      />
    </div>
  )}

  <ListingGrid
    heading="Start With the Breeds Our Reviewers Chose"
    headingAccent="Our Reviewers"
    subhead="Cavapoo, Maltipoo and Mini Dachshund come up most often in the reviews above. Each page publishes its own all-in price, its HDB status, and the puppies available in that breed right now."
    items={breedCta}
    footerCtaLabel="Or compare all 48 breeds side by side"
    footerCtaHref="/puppies/"
  />

  <BannerRibbon
    heading="Read them all? Come and meet the puppies"
    body="We are at 2 Balestier Road, open seven days. Message us first and we will have the breeds you are considering ready when you arrive."
    ctaLabel="WhatsApp us"
    ctaMessage="Hi! I read your Google reviews and I'd like to visit. Which puppies will be at the shop this week?"
    variant="dark"
  />

  <div id="faq" class="scroll-mt-40">
    <FAQ heading="Questions About Our Reviews" items={faqItems} />
  </div>

  <FinalCta
    breed="Puppy"
    heading="Come and See If the Reviews Are Right"
