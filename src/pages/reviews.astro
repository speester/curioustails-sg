    browseLabel="See every puppy available now"
  />

  <Schema {schemas} />

  <RelatedPosts route="/reviews/" />
</BaseLayout>

<style>
  /* A fixed-ratio photo makes CSS columns pointless and a grid keeps the rows aligned,
     which is what every other listing on this site does. */
  .review-wall {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .review-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .review-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 640px) {
    .review-wall { column-count: 2; }
  }
  @media (min-width: 1024px) {
    .review-wall { column-count: 3; }
  }
  /* The disclosure marker is replaced by the button's own chevron. */
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ''; }
  .review-card {
    display: flex;
    flex-direction: column;
  }
  /* A handful of reviews run several hundred words. Clamp them so one long review does
     not set the row height for its neighbours; the full text stays in the HTML. */
  .review-card blockquote {
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
